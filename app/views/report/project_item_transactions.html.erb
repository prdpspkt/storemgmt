<div class="container">
  <div class="row text-center">
    <div class="col-12 text-right">म.ले.प.फा.नं. ५२</div>
    <div class="col-12 gov_name">प्रदेश सरकार</div>
    <div class="col-12 min_name">भौतिक पूर्वाधार विकास मन्त्रालय</div>
    <div class="col-12 off_name">खानेपानी तथा सरसफाई डिभिजन कार्यलय</div>
    <div class="col-12 min_name">गण्डकी प्रदेश, तनहुँ</div>
    <div class="col-12 form_name">खर्च भएर जाने जिन्सी मालसामानको खाता (आयोजनागत मूल खाता)</div>
  </div>
  <div class="row">
    <div class="col-12">
      <table class="table table-sm borderless">
        <tr>
          <td><b>सामानको नाम: </b> <%= @item.name_of_item_ne %></td>
          <td></td>
          <td><b>जिन्सी खाता पाना नं.:</b> <%= nd @item.item_register_page_no %> </td>
        </tr>
        <tr>
          <td><b>इकाई:</b> <%= @item.unit_ne %></td>
          <td><b>सम्पति बर्गिकरण संकेत नं:</b></td>
          <td></td>
        </tr>
        <tr>
          <td><b>स्पेसिफिकेसन:</b></td>
          <td></td>
          <td></td>
        </tr>
      </table>
    </div>
  </div>
  <div class="row">
    <div class="col-12">
      <table class="table table-sm table-black-border">
        <tr>
          <th rowspan="2">मिति:</th>
          <th rowspan="2">दाखिला/निकासी नं</th>
          <th colspan="3">आम्दानी</th>
          <th colspan="3">खर्च</th>
          <th colspan="2">बाँकी</th>
          <th rowspan="2">कैफियत</th>
          <th class="no-print" rowspan="2"></th>
        </tr>
        <tr>
          <th>परिमाण</th>
          <th>दर</th>
          <th>जम्मा</th>
          <th>परिमाण</th>
          <th>दर</th>
          <th>जम्मा</th>
          <th>परिमाण</th>
          <th>जम्मा</th>
        </tr>
        <% @income = @transactions.where(transaction_type: 1).sum(:quantity) %>
        <% @expense = @transactions.where.not(transaction_type: 1).sum(:quantity) %>
        <% @quantity = @income - @expense %>
        <% @transactions.each do |t| %>
          <tr id="trans-<%= t.id %>">
            <% if t.transaction_type == 1 %>
              <td>
                <% if t.transaction_date %>
                <%= nd (t.transaction_date).strftime("%Y-%m-%d") %>
                <% end %>
              </td>
              <td><%= nd t.entry_release_no %></td>
              <td><%= nd t.quantity %></td>
              <td><%= nd t.rate %></td>
              <td><%= nd t.amount %></td>
              <td></td>
              <td></td>
              <td></td>
              <td></td>
              <td></td>
              <td><%= t.remarks %></td>
              <td class="no-print">
                <% if t.created_at.today?  %>
                <%= link_to delete_btn.html_safe, t, remote: true, method: :delete, data: { confirm: 'Are you sure?' } %></td>
                <% end %>
            <% else %>
              <td> <% if t.transaction_date %>
                <%= nd (t.transaction_date).strftime("%Y-%m-%d") %>
                  <% end %>
                </td>
              <td><%= nd t.entry_release_no %></td>
              <td></td>
              <td></td>
              <td></td>
              <td><%= nd t.quantity %></td>
              <td><%= nd t.rate %></td>
              <td><%= nd t.amount %></td>
              <td></td>
              <td></td>
              <td>
                <% if t.released_to %>
                  <a href="/project/<%= t.released_to %>/<%= t.item_id %>/transactions"><%= get_project_name_by_id t.released_to %></a>
                  मा सारिएको
                <% else %>
                  <%= t.remarks %>
                <% end %>
              </td>
              <td class="no-print">
                <% if t.created_at.today?  %>
                <%= link_to delete_btn.html_safe, t, remote: true, method: :delete, data: { confirm: 'Are you sure?' } %></td>
                  <% end %>
            <% end %>
          </tr>
        <% end %>
        <tr>
          <td></td>
          <td><b>जम्मा</b></td>
          <td><b><%= nd @income %></b></td>
          <td></td>
          <td><b><%= nd @total_amt_entry %></b></td>
          <td><b><%= nd @expense %></b></td>
          <td></td>
          <td><b><%= nd @total_amt_release %></b></td>
          <td><b><%= nd @quantity %></td>
          <td></td>
          <td></td>
          <td class="no-print"></td>
        </tr>
      </table>
    </div>
  </div>
</div>