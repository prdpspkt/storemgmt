    <th>मोडल नं</th>
    <th>इकाई</th>
    <th>परिमाण</th>
    <th>जम्मा परल मूल्य</th>
    <th>सुरु प्राप्त मिति</th>
    <th>सामानको भौतिक अवस्था</th>
  </tr>
  <tr>
    <td>१</td>
    <td>२</td>
