    <td>१०</td>
    <td>११</td>
    <td>१२</td>
  </tr>
  <% @office_handover_form_items.each do |item| %>
  <tr>
    <td><%= item.id %></td>
    <td><%= item.item_classification_no %></td>
    <td><%= item.item_register_page_no %></td>
    <td><%= item.name_of_item_ne %></td>
    <td><%= item.specification %></td>
    <td><%= item.item_identification_no %></td>
    <td><%= item.model_no %></td>
    <td><%= item.unit_ne %></td>
    <td><%= item.quantity %></td>
    <td><%= item.amount %></td>
    <td><%= item.received_date %></td>
    <td><%= item.physical_status %></td>
  </tr>
    <% end %>
  </tbody>
</table>
