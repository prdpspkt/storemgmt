<table class="table table-sm table-borderless">
  <tbody>
  <tr class="text-center">
    <td colspan="12" class="gov_name"><%= @office.gov %></td>
  </tr>
  <tr class="text-center">
    <td colspan="12" class="min_name"><%= @office.ministry %></td>
  </tr>
  <tr class="text-center">
    <td colspan="12" class="off_name"><%= @office.office %></td>
  </tr>
  <tr class="text-center">
    <td colspan="12" class="min_name"><%= @office.address %></td>
  </tr>
  <tr class="text-center">
    <td colspan="12" class="gov_name">कार्यालय कोड नं.: <%= @office.code %></td>
  </tr>
  <tr class="text-center">
    <td colspan="12" class="off_name">हस्तान्तरण फाराम</td>
  </tr>
  <tr>
    <td colspan="12">यस कार्यालयको तपसिल अनुसारको मालसामान हस्तान्तरण गरिएको छ ।</td>
  </tr>
  <tr>
    <td colspan="12">सामान हस्तान्तरण गर्ने निर्णय नं: <%= nd @office_handover_form.decision_no %></td>
  </tr>
  <tr>
    <td colspan="9">सामान हस्तान्तरण गर्ने निर्णय मितिः <%= ndate @office_handover_form.decision_date %></td>
    <td >मिति: <%= ndate @office_handover_form.date %></td>
  </tr>
  <tr>
    <td colspan="9">सामान हस्तान्तरण गरिएको कार्यालयको नामः <%= @office_handover_form.handovered_office_name %></td>
    <td >हस्तान्तरण फारम नं: <%= nd @office_handover_form.handover_form_no %></td>
  </tr>
  </tbody>
</table>
<table class="table table-black-border table-sm">
  <tbody>
  <tr>
    <th>क्र.सं.</th>
