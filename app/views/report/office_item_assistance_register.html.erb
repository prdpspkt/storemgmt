<table class="table table-sm table-borderless">
  <tbody>
  <tr>
    <td class="text-center gov_name" colspan="15"><%= @office.gov %></td>
  </tr>
  <tr>
    <td class="text-center min_name" colspan="15"><%= @office.ministry %></td>
  </tr>
  <tr>
    <td class="text-center off_name" colspan="15"><%= @office.office %></td>
  </tr>
  <tr>
    <td class="text-center min_name" colspan="15"><%= @office.address %></td>
  </tr>
  <tr>
    <td class="text-center gov_name" colspan="15">कार्यालय कोड नं.: <%= @office.code %></td>
  </tr>
  <tr>
    <td class="text-center" colspan="15"><b>जिन्सी सहायक खाता</b></td>
  </tr>
  <tr>
    <td class="text-left" colspan="15">जिन्सी सामान उपयोग गर्नेको नाम</td>
  </tr>
  <tr>
    <td class="text-left" colspan="12">एकाइ: <%= @item_assistance_register.unit_ne %></td>
    <td colspan="2" class="text-right">खाता पाना.नं.</td>
    <td></td>
  </tr>
  </tbody>
</table>
<table class="table table-sm table-bordered table-black-border">
  <tbody>
  <tr>
    <td rowspan="2">मिति</td>
    <td rowspan="2">माग/निकासा फारम नं</td>
    <td rowspan="2">जिन्सी खाता पाना.नं.</td>
    <td colspan="6">मालसमानको विवरण</td>
    <td colspan="5" class="text-center">समान बुझ्ने र बुझाउनेको विवरण (भाडामा लिएको दिएको समेत)</td>
    <td rowspan="2">फाँटबालाको दस्तखत</td>
  </tr>
  <tr>
    <td>मालसमानको नाम</td>
    <td>स्पेसिफिकेसन</td>
    <td>सामानको पहिचान नं</td>
    <td>मोडल नं</td>
    <td>परिमाण</td>
    <td>जम्मा परल मूल्य</td>
    <td>बुझिलिएको मिति</td>
    <td>फिर्ता गर्नुपर्ने मिति</td>
    <td>फिर्ता गरेको परिमाण</td>
    <td>फिर्ता गरेको मिति</td>
    <td>नाम र दस्तखत</td>
  </tr>
  <tr>
    <td>१</td>
    <td>२</td>
    <td>३</td>
    <td>४</td>
    <td>५</td>
    <td>६</td>
    <td>७</td>
    <td>८</td>
    <td>९</td>
    <td>१०</td>
    <td>११</td>
    <td>१२</td>
    <td>१३</td>
    <td>१४</td>
    <td>१५</td>
  </tr>
  <% @item_assistance_register_items.each do |item| %>
    <tr>
      <td><%= item.date %></td>
      <td><%= item.order_release_no %></td>
      <td><%= item.item_assistance_register.item_register_page_no %></td>
      <td><%= item.name_of_item_ne %></td>
      <td><%= item.specification %></td>
      <td><%= item.item_identification_no %></td>
      <td><%= item.model_no %></td>
      <td><%= item.quantity %></td>
      <td><%= item.amount %></td>
      <td><%= item.date %></td>
      <td><%= item.date_to_be_returned %></td>
      <td><%= item.returned_quantity %></td>
      <td><%= item.returned_date %></td>
      <td><%= item.name_of_user %></td>
      <td></td>
    </tr>
  <% end %>
  </tbody>
</table>
