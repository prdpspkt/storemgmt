<div class="row">
  <div class="col-6">
    <h1>जिन्सी निसर्ग/मिन्हा फारामहरू</h1>
    <!-- Button trigger modal -->
  </div>
  <div class="col-6">
    <div class="float-right imex">
      <%= link_to new_btn.html_safe, new_office_item_disposal_path %>
    </div>
  </div>
</div>
<div class="table-responsive">
<table class="table table-sm" id="dttb-item_disposals" data-sort="true" data-source="<%= url_for(format: :json)%>">
  <thead>
    <tr>
      <th data-data="fy">आ.व.</th>
      <th data-data="description">विवरण</th>
      <th data-data="decision_date">निर्णय मिति</th>
      <th data-data="decision_made_by">निर्णय गर्ने अधिकारि र पद</th>
      <th data-data="url" data-orderable="false" data-class-name="all" data-searchable="false" class="skip-export" width="100px"></th>
    </tr>
  </thead>

</table>
</div>

<br>

