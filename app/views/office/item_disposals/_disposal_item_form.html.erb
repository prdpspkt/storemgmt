<%= form_with(model: item_disposal_item, local: true) do |form| %>
  <% if item_disposal_item.errors.any? %>
    <div id="error_explanation">
      <h2><%= pluralize(item_disposal_item.errors.count, "error") %> prohibited this item_disposal_item from being saved:</h2>

      <ul>
      <% item_disposal_item.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
      </ul>
    </div>
  <% end %>
<div class="row">
<%= form.hidden_field :item_disposal_id %>

  <div class="col-2">
    <%= form.label :item_transaction_id %>
    <%= form.select(:item_transaction_id, @items.collect { |item| ["#{item.item.name_of_item_en} (SKU: #{item.sku}, MODEL: #{item.model})", item.id ]}, {include_blank: true}, {class: "form-control", required: true}) %>
  </div>
  
  <div class="col-2">
    <%= form.label :received_date %>
    <%= form.text_field :received_date,  class: "form-control date-picker", required: :required  %>
  </div>

  <div class="col-2">
    <%= form.label :used_year %>
    <%= form.text_field :used_year, class: "form-control", required: :required  %>
  </div>

  <div class="col-2">
    <%= form.label :quantity %>
    <%= form.text_field :quantity, class: "form-control", required: :required  %>
  </div>

  <div class="col-2">
    <%= form.label :current_marked_price %>
    <%= form.text_field :current_marked_price, class: "form-control", required: :required  %>
  </div>

  <div class="col-2">
    <%= form.label :reason_for_disposal %>
    <%= form.text_field :reason_for_disposal, class: "form-control", required: :required  %>
  </div>

</div>
  <div class="separator"></div>
  <div class="float-right">
    <%= form.submit :save, class: "btn btn-success" %>
  </div>
<% end %>
