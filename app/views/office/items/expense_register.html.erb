<div class="row no-print">
  <div class="col-md-6">
    <h1>जिन्सी खाता पाना</h1>
  </div>
  <div class="col-md-6 text-right">
    <%= link_to back_btn.html_safe, expense_index_office_items_url %>
  </div>
</div>
<div class="separator"></div>
<table class="table table-borderless table-sm">
  <tr>
    <td><h3><%= @item.name_of_item_ne %></h3></td>
  </tr>
  <tr>
    <td>इकाई: <%= @item.unit_ne %></td>
    <td>जिन्सी सङ्केत नं:<%= nd @item.item_classification_no %></td>
  </tr>
  <tr>
    <td>आर्थिक वर्ष: <%= @fiscal_year.fy %></td>
    <td>जिन्सी खाता पाना नं: <%= nd @item.item_register_page_no %></td>
  </tr>
</table>
<table class="table table-sm table-black-border">
  <tbody>
  <tr class="text-center">
    <td rowspan="2">मितिः</td>
    <td rowspan="2">दाखिला / निकासा नं</td>
    <td colspan="3">स्टोर दाखिला (आम्दानी)</td>
    <td colspan="3">निकासा (खर्च)</td>
    <td colspan="3">बाँकी</td>
    <td rowspan="2">कैफियत</td>
  </tr>
  <tr class="text-center">
    <td>परिमाण</td>
    <td>दर</td>
    <td>रकम</td>
    <td>परिमाण</td>
    <td>दर</td>
    <td>रकम</td>
    <td>परिमाण</td>
    <td>दर</td>
    <td>रकम</td>
  </tr>
  <tr class="text-center">
    <td>१</td>
    <td>२</td>
    <td>३</td>
    <td>४</td>
    <td>५</td>
    <td>६</td>
    <td>७</td>
    <td>८</td>
    <td>९</td>
    <td>१०</td>
    <td>११</td>
    <td>१२</td>
  </tr>
  <% @qty = 0 %>
  <% @amt = 0 %>
  <% @item.item_transactions.each do |oeirt| %>
    <% if oeirt.transaction_type > 0 %>
      <% @qty = @qty + oeirt.quantity %>
      <% @amt = @amt + oeirt.amount %>
      <tr class="text-center">
        <td><%= ndate oeirt.transaction_date %></td>
        <td><%= nd oeirt.entry_no %></td>
        <td><%= nd oeirt.quantity %></td>
        <td><%= nd oeirt.rate %></td>
        <td><%= nd oeirt.amount %></td>
        <td>&nbsp;</td>
        <td>&nbsp;</td>
        <td>&nbsp;</td>
        <td>&nbsp;<%= nd @qty %></td>
        <td>&nbsp;</td>
        <td><%= nd @amt %></td>
        <td>&nbsp;</td>
      </tr>
    <% end %>
    <% if oeirt.transaction_type < 0 %>
      <% @qty = @qty - oeirt.quantity %>
      <% @amt = @amt - oeirt.amount %>
      <tr class="text-center">
        <td><%= ndate oeirt.transaction_date %></td>
        <td><%= nd oeirt.entry_no %></td>
        <td></td>
        <td></td>
        <td></td>
        <td><%= nd oeirt.quantity %></td>
        <td><%= nd oeirt.rate %></td>
        <td><%= nd oeirt.amount %></td>
        <td>&nbsp;<%= nd @qty %></td>
        <td>&nbsp;</td>
        <td><%= nd @amt %></td>
        <td>&nbsp;</td>
      </tr>
    <% end %>
  <% end %>
  </tbody>
</table>
