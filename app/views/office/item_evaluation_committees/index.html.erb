<div class="row">
  <div class="col-6">
    <h1>जिन्सी निरीक्षण समिति</h1>
  </div>
  <div class="col-6">
    <!-- Button trigger modal -->
    <div class="float-right imex">
      <%= link_to new_btn.html_safe, new_office_item_evaluation_committee_path %>
    </div>
  </div>
</div>

<div class="table-responsive">
<table class="responsive nowrap table table-hover" id="dttb-office_item_evaluation_committees" data-sort="true" data-source="<%= url_for(format: :json)%>">
  <thead>
    <tr>
      <th data-data="name">नाम</th>
      <th data-data="fiscal_year">आ.व.</th>
      <th data-data="url" data-orderable="false" data-class-name="all" data-searchable="false" class="skip-export" width="100px"></th>
    </tr>
  </thead>
</table>
</div>
