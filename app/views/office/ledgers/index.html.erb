<div class="row">
  <div class="col-12">
    <h1><%= @report_name %></h1>
  </div>
  <div class="col-12 text-center">
    <a class="btn btn-success" href="<%= @generate_url %>" data-method="post" data-confirm="Are you sure to generate again? Prevous file will overwrite."><i class="fa fa-life-ring"></i>
      Generate PDF</a>
    <a class="btn btn-primary" target="_blank" href="<%= @download_url %>"><i class="fa fa-save"></i> Downlaod</a>
  </div>
</div>
<div class="row">
  <div class="col-12">
    <div class="separator"></div>
    <% unless @eitems.nil? %>
      <% @eitems.each do |item| %>
        <% if item.item_transactions.count > 0 %>
          <%= render "office/ledgers/expense_item_register", item: item %>
        <% end %>
      <% end %>
    <% end %>

    <% unless @nitems.nil? %>
      <% @nitems.each do |item| %>
        <% if item.item_transactions.count > 0 %>
          <%= render "office/ledgers/non_expense_item_register", item: item %>
        <% end %>
      <% end %>
    <% end %>
  </div>
</div>