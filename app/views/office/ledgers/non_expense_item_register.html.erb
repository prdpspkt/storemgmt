<div class="row">
  <div class="col-md-6 no-print">
    <h1>खर्च भएर नजाने (खप्ने) जिन्सी खाता</h1>
  </div>
  <div class="col-md-6 no-print text-right">
    <a class="btn btn-success no-print" role="button" href="<%= print_pdf_non_expense_item_register_office_ledgers_url %>" data-method="post" ><i class="fa fa-life-ring"></i>
      Generate Report </a>
    <a role="button" class="btn btn-primary no-print" href="<%= non_expense_item_register_office_ledgers_url(format: :pdf) %>" target="_blank"><i class="fa fa-print"></i>
      Print </a>
  </div>
  <div class="col-12">
    <% @items.each do |item| %>
      <% if item.item_transactions.count > 0 %>
        <%= render "office/ledgers/non_expense_item_register", item: item %>
      <% end %>
    <% end %>
  </div>
</div>
