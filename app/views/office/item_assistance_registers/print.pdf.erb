  <% @item_assistance_register_items.each do |item| %>
    <tr>
      <td><%= ndate item.taken_date %></td>
      <td><%= nd item.order_release_no %></td>
      <td><%= nd item.item.item_register_page_no %></td>
      <td><%= item.item.name_of_item_ne %></td>
      <td><%= item.specification %></td>
      <td><%= item.item_identification_no %></td>
      <td><%= item.model_no %></td>
      <td><%= nd item.quantity %></td>
      <td><%= nd item.amount %></td>
      <td><%= ndate item.taken_date %></td>
      <td><%= ndate item.date_to_be_returned %></td>
      <td><%= nd item.returned_quantity %></td>
      <td><%= ndate item.returned_date %></td>
      <td><%= item.returned_by %></td>
      <td></td>
    </tr>
  <% end %>
