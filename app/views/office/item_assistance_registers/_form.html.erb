<%= form_with(model: item_assistance_register, local: true) do |form| %>
  <% if item_assistance_register.errors.any? %>
    <div id="error_explanation">
      <h2><%= pluralize(item_assistance_register.errors.count, "error") %> prohibited this item_assistance_register from being saved:</h2>

      <ul>
      <% item_assistance_register.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
      </ul>
    </div>
  <% end %>
<div class="row">
  <div class="col-sm-6">
    <%= form.label :register_page_no %>
    <%= form.number_field :register_page_no, class:"form-control", readonly: :readonly %>
  </div>

  <div class="col-sm-6">
    <%= form.label :name_of_item %>
    <%= form.select(:item_id, Office::Item.all.collect{ |item| [item.name_of_item_en, item.id]}, {include_blank: "--select--"}, {class: "form-control"})%>
  </div>

  <div class="col-sm-6">
    <%= form.label :store_chief_signed_date %>
    <%= form.text_field :store_chief_signed_date, class:"form-control date-picker" %>
  </div>

  <div class="col-sm-6">
    <%= form.label :office_chief_signed_date %>
    <%= form.text_field :office_chief_signed_date, class:"form-control date-picker" %>
  </div>
</div>
<div class="separator"></div>
  <div class="float-right">
    <%= form.submit :save, class: "btn btn-success" %>
  </div>
<% end %>
