<div class="row">
  <div class="col-12">
    <h1>जिन्सी सहायक खाता: <%= @item_assistance_register.personnel.name_ne %></h1>
    <table class="table table-sm table-bordered">
      <tr>
        <th>खाता पाना नं.</th>
        <th>प्रयोग कर्ताको नाम</th>
      </tr>
      <tr>
        <td><%= @item_assistance_register.register_page_no %></td>
        <td><%= @item_assistance_register.personnel.name_ne %></td>
      </tr>
    </table>
  </div>
</div>

<div class="text-center">
  <%= link_to back_btn.html_safe, office_item_assistance_registers_path %>
  <%= link_to edit_big_btn.html_safe, edit_office_item_assistance_register_path(@item_assistance_register) %>
  <%= link_to print_big_btn.html_safe, "/office/report/office_item_assistance_register/#{@item_assistance_register.id}" %>
</div>
<div class="separator"></div>
<h2>सामान लिएको विवरण प्रविष्ट गर्ने</h2>
<%= render "iarf_1", item_assistance_register_item: @item_assistance_register_item %>
<h2>जिन्सी प्रयोगको विवरण</h2>
<table class="table table-sm table-bordered">
  <tr>
    <th>क्र.स.</th>
    <th>जिन्सी खाता पाना नं</th>
    <th>जिन्सी पहिचान नं</th>
    <th>सामानको नाम</th>
    <th>मोडल नं</th>
    <th>इकाई</th>
    <th>परिमाण</th>
    <th>सामान बुझेको मिति</th>
    <th>फिर्ता गर्नुपर्ने मिति</th>
    <th></th>
  </tr>
  <% @i = 1 %>
  <% @item_assistance_register_items.each do |item| %>
    <tr>
      <td><%= @i %></td>
      <td><%= nd item.item.item_register_page_no %></td>
      <td><%= nd item.item_identification_no %></td>
      <td><%= item.item.name_of_item_ne %></td>
      <td><%= item.model_no %></td>
      <td><%= item.item.unit_ne %></td>
      <td><%= nd item.quantity %></td>
      <td><%= ndate item.taken_date %></td>
      <td><%= ndate item.date_to_be_returned %></td>
      <td>
        <%= link_to edit_btn.html_safe, edit_office_item_assistance_register_item_path(item) %>
        <%= link_to destroy_btn.html_safe, item, data: { method: :delete, confirm: "Are you sure to delete this record?"} %>
      </td>
    </tr>
    <% @i = @i + 1 %>
  <% end %>
</table>