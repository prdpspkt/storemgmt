<h1>कर्मचारीहरु</h1>
<table class="table data-table" id="dttb-personnels" data-sort="true" data-source="<%= url_for(format: :json)%>">
  <thead>
    <tr>
      <th data-data="ctroll">सिट्रोल</th>
      <th data-data="name_ne">नाम</th>
      <th data-data="post">पद</th>
      <th data-data="level_class">तह/श्रेणी</th>
      <th data-data="address">ठेगाना</th>
      <th data-data="phone">फोन</th>
      <th data-data="url" data-orderable="false" data-class-name="all" data-searchable="false" class="skip-export" width="100px"></th>
    </tr>
  </thead>

</table>
<div class="separator"></div>
<%= link_to new_btn.html_safe, new_office_personnel_path %>