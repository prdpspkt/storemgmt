<div class="row">
  <div class="col-6">
    <h1>खरिद बोलपत्रहरू</h1>
  </div>
  <div class="col-6">
    <div class="float-right imex">
      <%= link_to new_btn.html_safe, new_office_tender_path %>
    </div>
  </div>
</div>
<div class="table-responsive">
<table class="table table-sm" id="dttb-project_purchase_tenders" data-sort="true" data-source="<%= url_for(format: :json)%>">
  <thead>
    <tr>
      <th data-data="tender_no">टेन्डर सङ्ख्या</th>
      <th data-data="tender_name">टेण्डरको नाम</th>
      <th data-data="tender_date">प्रकाशित मिति</th>
      <th data-data="url" data-orderable="false" data-class-name="all" data-searchable="false" class="skip-export" width="100px"></th>
    </tr>
  </thead>

</table>
</div>
<br>
