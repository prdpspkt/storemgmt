<%= form_with(model: tender_item, local: true) do |form| %>
  <% if tender_item.errors.any? %>
    <div id="error_explanation">
      <h2><%= pluralize(tender_item.errors.count, "error") %> prohibited this project_tender_item
        from being saved:</h2>

      <ul>
        <% tender_item.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>
  <%= form.hidden_field :tender_id, value: @tender.id %>
  <div class="row">

    <div class="col-sm-3">
      <%= form.label :name_of_item %>
      <%= form.select(:item_id, Office::Item.all.collect { |i| [i.name_of_item_en, i.id] }, {include_blank: "select"}, {class: "form-control select2", required: :required}) %>
    </div>

    <div class="col-sm-2">
     <span class="text-danger"><%= form.label :is_vatable %></span>
      <%= form.check_box(:is_vatable, class: "form-control", checked: true) %>
    </div>

    <div class="col-sm-2">
      <%= form.label :quantity %>
      <%= form.number_field :quantity, step: :any, class: "form-control", required: true %>
    </div>

    <div class="col-sm-2">
      <%= form.label :rate %>
      <%= form.number_field :rate, step: :any, class: "form-control", required: true %>
    </div>


    <div class="col-sm-3">
      <%= form.label :remarks %>
      <%= form.text_field :remarks, class: "form-control preeti" %>
    </div>
  </div>
  <div class="separator"> </div>
  <div class="float-right">
    <%= form.submit :save, class: "btn btn-success" %>
  </div>
<% end %>
