<table class="table table-sm table-borderless text-center">
  <tbody>
  <tr>
    <td class="gov_name"><%= @office.gov %></td>
  </tr>
  <tr>
    <td class="min_name"><%= @office.ministry %></td>
  </tr>
  <tr>
    <td class="off_name"><%= @office.office %></td>
  </tr>
  <tr>
    <td class="min_name"><%= @office.address %></td>
  </tr>
  <tr>
    <td class="gov_name">कार्यालय कोड नं.:</td>
  </tr>
  <tr>
    <td class="off_name">मर्मत, सम्भार तथा संरक्षण आवेदन फाराम</td>
  </tr>
  <tr>
    <td class="min_name">आर्थिक वर्षः <%= nd @repair_application_form.year %> साल <%= @repair_application_form.month %> महिना</td>
  </tr>
  </tbody>
</table>
<table class="table table-sm table-borderless">
<tbody>
  <tr>
    <td>&nbsp;</td>
    <td>&nbsp;</td>
    <td>&nbsp;</td>
    <td>&nbsp;</td>
    <td>&nbsp;</td>
    <td>मर्मत आवेदन फारम नं: <%= nd @repair_application_form.application_no %></td>
    <td>&nbsp;</td>
  </tr>
  <tr>
    <td>&nbsp;</td>
    <td>&nbsp;</td>
    <td>&nbsp;</td>
    <td>&nbsp;</td>
    <td>&nbsp;</td>
    <td>मितिः <%= ndate @repair_application_form.date %></td>
    <td>&nbsp;</td>
  </tr>
  <tr>
    <td>मर्मत आवेदनकर्ताले भर्ने</td>
    <td>&nbsp;</td>
    <td>&nbsp;</td>
    <td>&nbsp;</td>
    <td>&nbsp;</td>
    <td>&nbsp;</td>
    <td>&nbsp;</td>
  </tr>
</tbody>
</table>
<table class="table table-sm table-black-border">
  <tbody>
  <tr>
    <td>क्र.सं.</td>
    <td>सामानको बिवरण</td>
    <td>समान पहिचान नं</td>
    <td>अनुमानित मर्मत लागत</td>
    <td>मर्मत गर्नुपर्ने कारण</td>
    <td>मर्मत आवेदनकर्ताको नाम र सही</td>
    <td>कैफियत</td>
  </tr>
  <tr>
    <td>१</td>
    <td>२</td>
    <td>३</td>
    <td>४</td>
    <td>५</td>
    <td>६</td>
    <td>७</td>
  </tr>
  <% @i = 1 %>
  <% @repair_application_form_items.each do |item| %>
  <tr>
    <td><%= nd @i %></td>
    <td><%= item.item.name_of_item_ne %></td>
    <td><%= item.item_transaction.item_identification_no %></td>
    <td><%= nd item.approx_repair_cost %></td>
    <td><%= item.reason_to_repair %></td>
    <td><%= item.applicant_sign %></td>
    <td><%= item.remarks %></td>
  </tr>
  <% @i = @i + 1 %>
    <% end %>
  <tr>
    <td><b>कुल जम्मा रकमः</b></td>
    <td>&nbsp;</td>
    <td>&nbsp;</td>
    <td><b><%= nd @repair_application_form_items.sum(:approx_repair_cost) %></b></td>
    <td>&nbsp;</td>
    <td>&nbsp;</td>
    <td>&nbsp;</td>
  </tr>
  </tbody>
</table>
<table class="table table-sm table-borderless">
  <tbody>
  <tr>
    <td colspan="7">स्टोरकिपर/फाँटवालाले भर्ने</td>
  </tr>
  </tbody>
</table>
<table class="table table-sm table-black-border">
  <tbody>
  <tr class="text-center">
    <td>जिन्सी संकेत नं</td>
    <td>वारेन्टी अवधि भए / नभएको</td>
    <td>अगाडी मर्मत गरिएको पटकः</td>
    <td>यस अघि मर्मत गरिएको मितिः</td>
    <td>अगाडि मर्मत गरिएको रकमः</td>
  </tr>
  <% @repair_application_form_items.each do |item| %>
    <% if get_current_repair_count(item) != false %>
  <tr>
    <td class="text-center"><%= nd item.item.item_register_page_no %></td>
    <td></td>
    <td class="text-center">
      <%= nd get_current_repair_count(item) %>
    </td>
    <td><%= ndate get_last_repair_record(item).date  %></td>
    <td><%= nd get_current_repair_cost(item) %></td>
  </tr>
  <% end %>
    <% end %>
  </tbody>
</table>
<table class="table table-sm table-borderless">
  <tbody>
  <tr>
    <td colspan="7">श्री ...........</td>
  </tr>
  <tr>
    <td colspan="7">मर्मत आदेश दिइएको व्यक्ति/निकायको नाम: <%= @repair_application_form.vendor.vendor_name %></td>
  </tr>
  <tr>
    <td colspan="3">ठेगाना : <%= @repair_application_form.vendor.vendor_address %></td>
    <td colspan="4">फोन नं: <%= nd @repair_application_form.vendor.vendor_phone %></td>
  </tr>
  <tr>
    <td colspan="3">संस्था दर्ता नं: <%= nd @repair_application_form.vendor.vendor_registration %></td>
    <td colspan="4">प्यान नं : <%= nd @repair_application_form.vendor.vendor_pan %></td>
  </tr>
  <tr>
    <td colspan="7">माथि उल्लिखित सामानको मर्मत गरि मिति <%= ndate @repair_application_form.within_date %> भित्र <%= @repair_application_form.office.office %>,  <%= @repair_application_form.office.address %> स्थानमा बिल
      /इन्भाइससहित बुझाउनुहोला ।
    </td>
  </tr>
  <tr>
    <td colspan="3">सिफारिस गर्ने शाखा प्रमुखको सहीः</td>
    <td colspan="2">सिफारिस गर्ने प्राविधिकको सहीः</td>
    <td colspan="2">स्वीकृत गर्ने कार्यालय प्रमुखको सहीः</td>
  </tr>
  <tr>
    <td colspan="3">नामः <%= @repair_application_form.store_body.section_chief_name %></td>
    <td colspan="2">नामः <%= @repair_application_form.technical_person_name %></td>
    <td colspan="2">नामः <%= @repair_application_form.store_body.office_chief_name %></td>
  </tr>
  <tr>
    <td>दर्जाः</td>
    <td>&nbsp;</td>
    <td>&nbsp;</td>
    <td>दर्जाः</td>
    <td>&nbsp;</td>
    <td>दर्जाः</td>
    <td>&nbsp;</td>
  </tr>
  <tr>
    <td>मितिः</td>
    <td>&nbsp;</td>
    <td>&nbsp;</td>
    <td>मितिः</td>
    <td>&nbsp;</td>
    <td>मितिः</td>
    <td></td>
  </tr>
  </tbody>
</table>