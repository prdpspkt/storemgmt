<div class="table-responsive">
<table class="table table-sm" id="dttb-repair_application_forms" data-sort="true" data-source="<%= url_for(format: :json)%>">
  <thead>
    <tr>
      <th data-data="application_no">आवेदन नं</th>
      <th data-data="date">मिति</th>
