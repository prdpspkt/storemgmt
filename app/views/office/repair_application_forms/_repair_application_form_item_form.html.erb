<%= form_with(model: repair_application_form_item, local: true) do |form| %>
  <% if repair_application_form_item.errors.any? %>
    <div id="error_explanation">
      <h2><%= pluralize(repair_application_form_item.errors.count, "error") %> prohibited this repair_application_form_item from being saved:</h2>

      <ul>
        <% repair_application_form_item.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>
  <div class="row">
    <%= form.hidden_field :repair_application_form_id, value: @repair_application_form.id %>
    <div class="col-md-4">
      <%= form.label :name_of_item %>
      <%= form.select(:item_transaction_id, @transactions.collect{ |item| ["#{item.item.name_of_item_en} (SP: #{item.specification}, MO: #{item.model}, ID:#{item.item_identification_no})", item.id]}, {include_blank: true},{class: "form-control select2", required: true}) %>
    </div>
    <div class="col-md-2">
      <%= form.label :approx_repair_cost %>
      <%= form.number_field :approx_repair_cost, class: "form-control", step: "0.01", required: true %>
    </div>

    <div class="col-md-2">
      <%= form.label :reason_to_repair %>
      <%= form.text_field :reason_to_repair, class: "form-control preeti", required: true %>
    </div>
    <div class="col-md-2">
      <%= form.label :applicant_sign %>
      <%= form.select(:personnel_id, @personnels.collect{|p|[p.name_en, p.id]}, {include_blank: "select"}, { class: "form-control select2", required: true}) %>
    </div>
    <div class="col-md-2">
      <%= form.label :remarks %>
      <%= form.text_field :remarks, class: "form-control preeti" %>
    </div>
  </div>
  <div class="separator"></div>
  <div class="float-right">
    <%= form.submit :save, class: "btn btn-success" %>
  </div>
<% end %>
