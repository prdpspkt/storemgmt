<div class="row">
  <div class="col-6">
    <h1>नियन्त्रण संयन्त्र</h1>
  </div>
  <div class="col-6">
    <div class="float-right imex">
      <%= link_to new_btn.html_safe, new_office_store_body_path %>
      <%= link_to edit_big_btn.html_safe, edit_office_store_body_path(@store_body) %>
    </div>
  </div>
</div>

<div class="table-responsive">
<table class="table table-bordered">
  <tr>
    <th>कार्यालय प्रमुख</th>
    <td><%= @store_body.office_chief_name %></td>
    <th>पद</th>
    <td><%= @store_body.office_chief_designation %></td>
  </tr>
  <tr>
    <th> शाखा प्रमुख</th>
    <td> <%= @store_body.section_chief_name %></td>
    <th>पद</th>
    <td><%= @store_body.section_chief_designation %></td>
  </tr>
  <tr>
    <th>भण्डार प्रमुख</th>
    <td><%= @store_body.store_keeper_name %></td>
    <th>पद</th>
    <td><%= @store_body.store_keeper_designation %></td>
  </tr>
</table>
</div>
