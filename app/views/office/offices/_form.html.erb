<%= form_with(model: office, local: true) do |form| %>
  <% if office.errors.any? %>
    <div id="error_explanation">
      <h2><%= pluralize(office.errors.count, "error") %> prohibited this office from being saved:</h2>

      <ul>
      <% office.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
      </ul>
    </div>
  <% end %>
<div class="row">
  <div class="col-md-6">
    <%= form.label :gov %>
    <%= form.text_field :gov, class: "form-control preeti" %>
  </div>

  <div class="col-md-6">
    <%= form.label :ministry %>
    <%= form.text_field :ministry, class: "form-control preeti" %>
  </div>

  <div class="col-md-6">
    <%= form.label :department %>
    <%= form.text_field :department, class: "form-control preeti" %>
  </div>

  <div class="col-md-6">
    <%= form.label :office %>
    <%= form.text_field :office, class: "form-control preeti" %>
  </div>

  <div class="col-md-6">
    <%= form.label :address %>
    <%= form.text_field :address, class: "form-control preeti" %>
  </div>

  <div class="col-md-6">
    <%= form.label :phone %>
    <%= form.text_field :phone, class: "form-control" %>
  </div>

  <div class="col-md-6">
    <%= form.label :fax %>
    <%= form.text_field :fax, class: "form-control" %>
  </div>

  <div class="col-md-6">
    <%= form.label :email %>
    <%= form.text_field :email, class: "form-control" %>
  </div>
  
  <div class="col-md-6">
    <%= form.label :input_system %> <br>
    <p>नियमित बाहेकका प्रविष्ट प्रणालीका अक्षरहरु स्वत युनिकोडमा परिवर्तन हुने छन </p>
    <%= form.label :regular %>
    <%= form.radio_button :input_system, "regular", required: true%>
    <%= form.label :preeti %>
    <%= form.radio_button :input_system, "preeti" %>
  </div>

  <div class="col-md-6">
    <%= form.label :input_system %> <br>
    <p> आयोजनागत सापटी सक्रिय वा निस्कृय गर्ने </p>
    <%= form.check_box :sapati %>
  </div>

  <div class="col-md-12">
    <%= form.submit "save", class: "float-right btn btn-success" %>
  </div>
</div>
<% end %>
