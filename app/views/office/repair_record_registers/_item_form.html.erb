<%= form_with(model: repair_record_register_item, local: true) do |form| %>
  <% if repair_record_register_item.errors.any? %>
    <div id="error_explanation">
      <h2><%= pluralize(repair_record_register_item.errors.count, "error") %> prohibited this repair_record_register_item from being saved:</h2>

      <ul>
        <% repair_record_register_item.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>
  <%= form.hidden_field :repair_record_register_id, required: true %>
  <div class="row">
    <div class="col-md-2">
      <%= form.label :date %>
      <%= form.text_field :date, class: "form-control date-picker", required: true %>
    </div>

    <div class="col-md-2">
      <%= form.label :repair_application_no %>
      <%= form.number_field :repair_application_no, class: "form-control", required: true %>
    </div>

    <div class="col-md-2">
      <%= form.label :applicant_name %>
      <%= form.text_field :applicant_name, class: "form-control", required: true %>
    </div>

    <div class="col-md-2">
      <%= form.label :changed_part_name %>
      <%= form.text_field :changed_part_name, class: "form-control", required: true %>
    </div>

    <div class="col-md-2">
      <%= form.label :changed_part_cost %>
      <%= form.number_field :changed_part_cost, class: "form-control", required: true, step: ".01" %>
    </div>

    <div class="col-md-2">
      <%= form.label :other_expense %>
      <%= form.text_field :other_expense, class: "form-control" %>
    </div>

    <div class="col-md-3">
      <%= form.label :other_expense_cost %>
      <%= form.number_field :other_expense_cost, step: ".01", class: "form-control" %>
    </div>


    <div class="col-md-3">
      <%= form.label :vendor_name %>
      <%= form.select(:vendor_id, @vendors.collect{ |v| [v.vendor_name, v.id]}, {include_blank: :choose}, {class: "form-control select2", required: :required}) %>
    </div>

    <div class="col-md-3">
      <%= form.label :justified_by %>
      <%= form.text_field :justified_by, class: "form-control" %>
    </div>

    <div class="col-md-3">
      <%= form.label :remarks %>
      <%= form.text_field :remarks, class: "form-control" %>
    </div>
  </div>
  <div class="separator"></div>
  <div class="float-right">
    <%= form.submit :save, class: "btn btn-success" %>
  </div>
<% end %>
