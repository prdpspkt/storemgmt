    <table class="table black-border">
      <thead>
      <tr class="text-center" >
        <th rowspan="2">क्र.स.</th>
        <th rowspan="2">खाता पाना नं</th>
        <th rowspan="2">जिन्सी वर्गीकरण नं</th>
        <th rowspan="2" class="bibaran" width="350px">विवरण</th>
        <th rowspan="2">परिमाण</th>
        <th rowspan="2">इकाई</th>
        <th rowspan="2">दर</th>
        <th colspan="2">स्पेसिफिकेसन</th>
        <th colspan="3">भौतिक अवस्था</th>
        <th colspan="2">प्रयोगमा</th>
        <th colspan="4">भौतिक अवस्था</th>
        <th rowspan="2">जम्मा मुल्य</th>
        <th rowspan="2">कुल परिमाण</th>
      </tr>
      <tr>
        <th>मिलान भएको संख्या</th>
        <th>मिलान नभएको संख्या</th>
        <th>घट सङ्ख्या</th>
        <th>बढ सङ्ख्या</th>
        <th>घटे/बढको सङ्ख्या</th>
        <th>प्रयोगमा रहेको</th>
        <th>प्रयोगमा नरहेको</th>
        <th>मर्मत गर्नुपर्ने</th>
        <th>लिलाम विक्री गर्नुपर्ने</th>
        <th>मिन्हा गर्नु पर्ने</th>
        <th>संरक्षण गर्नु पर्ने</th>
      </tr>
      </thead>
      <tbody>
      <% @sn = 1 %>
      <% @item_evaluation.item_evaluation_items.order("id ASC").each do |item| %>
        <tr class="text-center">
          <td><%= nd @sn %></td>
          <td><%= nd item.item_register_page_no %></td>
          <td><%= nd item.item_classification_no %></td>
          <td class="text-left" style="min-width: 250px"><%= nd item.name_of_item_ne %></td>
          <td><%= nd item.quantity %></td>
          <td><%= nd item.unit_ne %></td>
          <td><%= nd item.rate %></td>
          <td class="text-right"><%= nd item.amount %></td>
          <td id="matched-<%= item.id  %>"><%= nd item.matched %></td>
          <td id="unmatched-<%= item.id  %>"><%= nd item.unmatched %></td>
          <td id="dquantity-<%= item.id  %>"><%= nd item.dquantity %></td>
          <td id="iquantity-<%= item.id  %>"><%= nd item.iquantity %></td>
          <td id="diquantity-<%= item.id  %>"><%= nd item.diquantity %></td>
          <td id="working-<%= item.id  %>"><%= nd item.working %></td>
          <td id="notworking-<%= item.id  %>"><%= nd item.notworking %></td>
          <td id="to_be_repaired-<%= item.id  %>"><%= nd item.to_be_repaired %></td>
          <td id="to_be_auctioned-<%= item.id  %>"><%= nd item.to_be_auctioned %></td>
          <td id="to_be_disposed-<%= item.id  %>"><%= nd item.to_be_disposed %></td>
          <td id="to_be_conserved-<%= item.id  %>"><%= nd item.to_be_conserved %></td>
          <td><%= nd item.total_quantity %></td>
        </tr>
        <% @sn = @sn + 1 %>
      <% end %>
      </tbody>
    </table>
    <div style="margin-top: 40px">
      <div>जिन्सी निरीक्षण समिति गठन मिति: <%= ndate @item_evaluation.item_evaluation_committee.committee_formation_date %></div>
      <div>जिन्सी निरीक्षण प्रतिवेदन पेश गरेको मिति: <%= ndate @item_evaluation.item_evaluation_committee.report_submission_date %></div>
      <div>जिन्सी निरीक्षण समितिका पदाधिकारीको विवरण:</div>
      <table class="table black-border">
        <tr>
          <td>क्र.स.</td>
          <td>नाम</td>
          <td>पद</td>
          <td>हस्ताक्षर</td>
        </tr>
        <% @sn = 1 %>
        <% @item_evaluation.item_evaluation_committee.item_evaluation_committee_members.each do |member| %>
          <tr>
            <td><%= nd @sn %></td>
            <td><%= member.personnel.name_ne %></td>
            <td><%= member. role %></td>
            <td></td>
          </tr>
          <% @sn = @sn+1 %>
        <% end %>
      </table>
    </div>
