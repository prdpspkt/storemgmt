<div class="row">
  <div class="col-md-6"><h1>जिन्सी निरीक्षण प्रतिवेदन फाराम</h1></div>
  <div class="col-md-6 text-right">
    <a class="btn btn-success no-print" role="button" href="<%= print_pdf_office_item_evaluation_url(@item_evaluation) %>" data-method="post" ><i class="fa fa-life-ring"></i>
    Generate Report </a>
    <a role="button" class="btn btn-primary no-print" href="<%= print_office_item_evaluation_url(@item_evaluation, format: :pdf) %>" target="_blank"><i class="fa fa-print"></i>
      Print </a>
  </div>
</div>
<div class="row">
  <div class="col-12">
    <table class="table table-sm table-bordered">
      <thead>
      <tr>
        <th>क्र.स.</th>
        <th>खाता पाना नं</th>
        <th>जिन्सी वर्गीकरण नं</th>
        <th class="bibaran" width="350px">विवरण</th>
        <th>परिमाण</th>
        <th>इकाई</th>
        <th>मिलान भएको संख्या</th>
        <th>मिलान नभएको संख्या</th>
        <th>घट सङ्ख्या</th>
        <th>बढ सङ्ख्या</th>
        <th>घटे/बढको सङ्ख्या</th>
        <th>प्रयोगमा रहेको</th>
        <th>प्रयोगमा नरहेको</th>
        <th>मर्मत गर्नुपर्ने</th>
        <th>लिलाम विक्री गर्नुपर्ने</th>
        <th>मिन्हा गर्नु पर्ने</th>
        <th>संरक्षण गर्नु पर्ने</th>
        <th></th>
      </tr>
      </thead>
      <tbody>
      <% @sn = 1 %>
      <% @item_evaluation_items.each do |item| %>

        <tr>
          <td><%= @sn %></td>
          <td><%= nd item.item_register_page_no %></td>
          <td><%= nd item.item_classification_no %></td>
          <td><%= nd item.name_of_item_ne %></td>
          <td><%= nd item.quantity %></td>
          <td><%= nd item.unit_ne %></td>
          <td id="matched-<%= item.id %>"><%= nd item.matched %></td>
          <td id="unmatched-<%= item.id %>"><%= nd item.unmatched %></td>
          <td id="dquantity-<%= item.id %>"><%= nd item.dquantity %></td>
          <td id="iquantity-<%= item.id %>"><%= nd item.iquantity %></td>
          <td id="diquantity-<%= item.id %>"><%= nd item.diquantity %></td>
          <td id="working-<%= item.id %>"><%= nd item.working %></td>
          <td id="notworking-<%= item.id %>"><%= nd item.notworking %></td>
          <td id="to_be_repaired-<%= item.id %>"><%= nd item.to_be_repaired %></td>
          <td id="to_be_auctioned-<%= item.id %>"><%= nd item.to_be_auctioned %></td>
          <td id="to_be_disposed-<%= item.id %>"><%= nd item.to_be_disposed %></td>
          <td id="to_be_conserved-<%= item.id %>"><%= nd item.to_be_conserved %></td>
          <td>
            <a data-url="<%= edit_office_item_evaluation_item_url(item) %>" class="btn btn-primary btn-sm oiei_form"><i class="fa fa-pencil text-white"></i></a>
          </td>
        </tr>
        <% @sn = @sn + 1 %>
      <% end %>
      </tbody>
    </table>

  </div>
</div>
<script type="text/javascript">
    $(".oiei_form").click(function (e) {
        e.stopPropagation();
        e.preventDefault();
        url = $(this).data("url");
        edwin = window.open(url, "Item Evaluation Item", "scrollbars=no,resizable=no,status=no,location=no,toolbar=no,menubar=no, width=700,height=400,left=100,top=100")
    });
</script>