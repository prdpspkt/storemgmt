<div class="row">
  <div class="col-6">
    <h1>जिन्सी निरीक्षण फाराम</h1>
  </div>
  <div class="col-6">
    <!-- Button trigger modal -->
    <div class="float-right imex">
      <% if @fiscal_year.status != true %>
      <a href="#" class="btn btn-success" data-toggle="modal" data-target="#item_evaluation_form">
        Generate
      </a>
        <% end %>
    </div>
  </div>
</div>

<div class="table-responsive">
<table class="responsive nowrap table table-hover" id="dttb-office_item_evaluations" data-sort="true" data-source="<%= url_for(format: :json)%>">
  <thead>
    <tr>
      <th data-data="fy">आर्थिक वर्ष</th>
      <th data-data="office_name">कार्यालयको नाम</th>
      <th data-data="description">रिपोर्ट विवरण</th>
     </tr>
  </thead>

</table>
</div>


<div class="modal" id="item_evaluation_form" tabindex="-1" role="dialog" aria-hidden="true">
  <div class="modal-dialog" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">जिन्सी निरीक्षण तयार गर्ने</h5>
        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
          <span aria-hidden="true">&times;</span>
        </button>
      </div>
      <div class="modal-body">
        <p class="text-danger">चा.लु. आ.व.मा एक पटक जिन्सी निरीक्षण प्रतिवेदन जेनेरेट गरिसकेको अवस्थामा नयाँ तयार गर्दा पुरानो जिन्सी फाराम स्वत खारेज हुन्छ त्यसैले स्टोरको सम्पूर्ण कारोबार सकिए पछि जिन्सी निरीक्षण तयार गर्नु पर्छ |</p>
        <%= form_with(model: @item_evaluation, url: generate_office_item_evaluations_url , remote: true) do |form| %>
  <% if @item_evaluation.errors.any? %>
    <div id="error_explanation">
      <h2><%= pluralize(@item_evaluation.errors.count, "error") %> prohibited this item_evaluation from being saved:</h2>

      <ul>
      <% @item_evaluation.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
      </ul>
    </div>
  <% end %>
<div class="row">

  <div class="col-6">
    <%= form.label :name %>
    <%= form.text_field :name, class: "form-control preeti", required: :required %>
  </div>

  <div class="col-6">
    <%= form.label :select_a_committee %>
    <%= form.select(:item_evaluation_committee_id, @item_evaluation_committees.collect{|committee| [committee.name, committee.id]}, {include_blank: true}, {class: 'form-control select2', required: :required}) %>
  </div>

</div>
  <div class="separator"></div>
  <div class="float-right">
    <%= form.submit :generate, class: "btn btn-primary", type: :submit %>
  </div>
<% end %>

      </div>
    </div>
  </div>
</div>