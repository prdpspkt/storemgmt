<div class="row">
  <div class="col-md-6"><h1>आर्थिक वर्षहरु </h1></div>
  <div class="col-md-6">
    <div class="imex float-right">
      <%= link_to new_btn.html_safe, new_office_fiscal_year_path %>
      <a class="btn btn-danger text-white " data-confirm="Are you sure ?" href="<%= close_form_office_fiscal_years_url %>"><i class="fa fa-close"></i> आ.व. बन्द गर्ने</a>
    </div>
    </div>
</div>
<div class="table-responsive">
<table class="table data-table" id="dttb-fiscal_years" data-sort="true" data-source="<%= url_for(format: :json)%>">
  <thead>
    <tr>
      <th data-data="fy">आर्थिक वर्ष</th>
      <th data-data="start_date">सुरु मिति</th>
      <th data-data="closing_date">अन्त्य मिति</th>
      <th data-data="status">अवस्था</th>
      <th data-data="url" data-orderable="false" data-class-name="all" data-searchable="false" class="skip-export" width="100px"></th>
    </tr>
  </thead>
</table>
</div>