<h1>आर्थिक वर्ष बन्द गर्ने</h1>
<p class="text-danger" style="font-weight: bold">
  आर्थिक वर्ष बन्द गर्नुभन्दा पहिले सम्पूर्ण कारोवार सकिएको एकिन हुनु पर्छ | जस्तै सबै मागफारम निकासा फाराम बर्बुझारत, वार्षिक मौज्दात तयार गरिसकेको, बार्षिक जिन्सी निरीक्षण प्रतिवेदन तयार गरिसकेको हुनु पर्दछ | यी कार्यहरू नसकी आर्थिक वर्ष बन्द गरेमा पुन रिपोर्ट जेनेरेट गर्न सकिने छैन |
</p>
<%= form_tag(close_office_fiscal_years_path, method: :post) do %>
  <div class="form-group">
    <%= label_tag :"बन्द गर्नुपर्ने आर्थिक वर्ष" %>
    <%= select_tag(:fiscal_year_id, options_for_select(@fiscal_years.collect{|fy| [fy.fy, fy.id]}), {include_blank: "Select a Fiscal Year", class: "form-control select-2", required: true }) %>
  </div>
  <div class="separator"></div>
  <%= button_tag :save, class: "btn btn-success float-right" %>

<% end %>