<%= form_with(model: rental_record_register_item, local: true) do |form| %>
  <% if rental_record_register_item.errors.any? %>
    <div id="error_explanation">
      <h2><%= pluralize(rental_record_register_item.errors.count, "error") %> prohibited this rental_record_register_item from being saved:</h2>

      <ul>
      <% rental_record_register_item.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
      </ul>
    </div>
  <% end %>
  <%= form.hidden_field :rental_record_register_id %>
<div class="row">
  <div class="col-md-3">
    <%= form.label :date %>
    <%= form.text_field :date, class: "form-control date-picker", readonly: true, required: true %>
  </div>

  <div class="col-md-3">
    <%= form.label :name_of_vendor %>
    <%= form.text_field :name_of_vendor, class: "form-control" %>
  </div>

  <div class="col-md-3">
    <%= form.label :approval_date %>
    <%= form.text_field :approval_date, class: "form-control date-picker", readonly: true, required: true  %>
  </div>

  <div class="col-md-3">
    <%= form.label :start_date %>
    <%= form.text_field :start_date, class: "form-control date-picker", readonly: true, required: true  %>
  </div>

  <div class="col-md-3">
    <%= form.label :end_date %>
    <%= form.text_field :end_date, class: "form-control date-picker", readonly: true, required: true  %>
  </div>

  <div class="col-md-3">
    <%= form.label :unit %>
    <%= form.select(:unit,{"महिना" => "महिना", "वर्ष" => "वर्ष", "दिन" => "दिन", "घण्टा" => "घण्टा" }, {include_blank: true}, {class: "form-control"}) %>
  </div>

  <div class="col-md-3">
    <%= form.label :duration %>
    <%= form.text_field :duration, class: "form-control", required: true %>
  </div>

  <div class="col-md-3">
    <%= form.label :rate %>
    <%= form.number_field :rate, step: :any, class: "form-control" %>
  </div>
</div>
<div class="separator"></div>
  <div class="float-right">
    <%= form.submit :save, class: "btn btn-success"%>
  </div>
<% end %>
