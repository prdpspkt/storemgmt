<%= form_with(model: rental_record_register, local: true) do |form| %>
  <% if rental_record_register.errors.any? %>
    <div id="error_explanation">
      <h2><%= pluralize(rental_record_register.errors.count, "error") %> prohibited this rental_record_register from being saved:</h2>

      <ul>
      <% rental_record_register.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
      </ul>
    </div>
  <% end %>
<div class="row">
  <div class="col-md-3">
    <%= form.label :name_of_item %>
    <%= form.select(:item_transaction_id, @transactions.collect{|item| ["#{item.item.name_of_item_en} ( SKU:  #{item.sku}, IDN: #{item.item_identification_no}", item.id]}, {include_blank: true}, {class: "form-control select2", required: true} ) %>
  </div>


  <div class="col-md-2">
    <%= form.label :is_taken_in_rent %>
    <%= form.check_box :is_taken_in_rent %>
  </div>

  <div class="col-md-2">
    <%= form.label :is_given_in_rent %>
    <%= form.check_box :is_given_in_rent %>
  </div>

  <div class="col-md-2">
    <%= form.label :store_keeper_signed_date %>
    <%= form.text_field :store_keeper_signed_date,  class: "form-control date-picker", readonly: true, required: true %>
  </div>

  <div class="col-md-3">
    <%= form.label :office_chief_signed_date %>
    <%= form.text_field :office_chief_signed_date, class: "form-control date-picker", readonly: true, required: true %>
  </div>
</div>
  <div class="separator"></div>
  <div class="float-right">
    <%= form.submit :save, class: "btn btn-success" %>
  </div>
<% end %>
