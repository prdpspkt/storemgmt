<style type="text/css" media="print" rel="stylesheet" xmlns="http://www.w3.org/1999/html">
  body{
      font-family: Arial;
      font-size: 22px!important;
      margin: 0px;
  }
</style>
<table class="table table-sm table-borderless text-center ">
  <tbody>
  <tr>
    <td class="gov_name"><%= @office.gov %></td>
  </tr>
  <tr>
    <td class="min_name"><%= @office.ministry %></td>
  </tr>
  <tr>
    <td class="off_name"><%= @office.office %></td>
  </tr>
  <tr>
    <td class="min_name"><%= @office.address %></td>
  </tr>
  <tr>
    <td class="min_name">कार्यालय कोड नं.: <%= @office.code %></td>
  </tr>
  <tr>
    <td class="off_name">वार्षिक मौज्दात विवरण <%= @fiscal_year.fy %></td>
  </tr>
  </tbody>
</table>
<table class="table table-sm table-bordered table-black-border">
  <thead>
  <tr class="text-center">
    <th rowspan="2">क्र.स.</th>
    <th rowspan="2">खाता पाना नं</th>
    <th rowspan="2">जिन्सी वर्गीकरण नं</th>
    <th rowspan="2" class="bibaran" width="350px">जिन्सी सामानको नाम</th>
    <th colspan="4">मौज्दात बाँकी</th>
    <th rowspan="2">जिन्सी सामानको भौतिक अवस्था</th>
    <th rowspan="2">कैफियत</th>
  </tr>
  <tr class="text-center">
    <th>परिमाण</th>
    <th>इकाई</th>
    <th>दर</th>
    <th>जम्मा रू</th>
  </tr>
</thead>
  <tbody>
  <% @i = 1 %>
  <% @office_stock.stock_items.order("item_id ASC").each do |item| %>
    <tr class="text-center">
      <td><%= nd @i %></td>
      <td><%= nd item.item.item_register_page_no %></td>
      <td><%= nd item.item.item_classification_no %></td>
      <td class="text-left"><%= item.item.name_of_item_ne %></td>
      <td class="text-right"><%= nd item.quantity %></td>
      <td><%= nd item.item.unit_ne %></td>
      <td class="text-right"><%= nd item.rate %></td>
      <td class="text-right"><%= nd item.amount %></td>
      <td><%= item.physical_status %></td>
      <td><%= item.remarks %></td>
    </tr>
    <% @i = @i + 1 %>
  <% end %>
  </tbody>
</table>