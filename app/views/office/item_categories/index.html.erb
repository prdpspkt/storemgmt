<h1>जिन्सी सामाग्रीको बर्गिकरणहरु</h1>

<table class="table data-table" id="dttb-item_categories" data-sort="true" data-source="<%= url_for(format: :json)%>">
  <thead>
    <tr>
      <th data-data="name_ne"><%= t("activerecord.attributes.item_category.name") %></th>
      <th data-data="name_en"></th>
      <th data-data="unit_ne"><%= t("activerecord.attributes.item_category.unit") %></th>
      <th data-data="unit_en"></th>
      <th data-data="url" data-orderable="false" data-class-name="all" data-searchable="false" class="skip-export" width="100px"></th>
    </tr>
  </thead>

</table>

<br>

<%= link_to new_btn.html_safe, new_office_item_category_path %>