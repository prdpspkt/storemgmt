<%= form_with(model: item_category, local: true) do |form| %>
  <% if item_category.errors.any? %>
    <div id="error_explanation">
      <h2><%= pluralize(item_category.errors.count, "error") %> prohibited this item_category from being saved:</h2>

      <ul>
      <% item_category.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
      </ul>
    </div>
  <% end %>
<div class="row">
  <div class="col-sm-6">
    <%= form.label :name %>
    <%= form.text_field :name_ne, class: "form-control preeti", required: true %>
  </div>

  <div class="col-sm-6">
    <%= form.label :name_in_english %>
    <%= form.text_field :name_en, class: "form-control", required: true %>
  </div>

  <div class="col-sm-6">
    <%= form.label :unit %>
    <%= form.text_field :unit_ne, class: "form-control preeti", required: true %>
  </div>
  <div class="col-sm-6">
    <%= form.label :unit_in_english %>
    <%= form.text_field :unit_en, class: "form-control", required: true %>
  </div>
</div>
<div class="separator"></div>
  <%= form.submit :save, class: "btn btn-success float-right" %>

<% end %>
