<h1>दर्ता भएका व्यवसायहरू</h1>
<div class="table-responsive">
<table class="table data-table" id="dttb-vendors" data-sort="true" data-source="<%= url_for(format: :json)%>">
  <thead>
    <tr>
      <th data-data="vendor_name">व्यवसायको नाम</th>
      <th data-data="vendor_registration">दर्ता नं</th>
      <th data-data="vendor_pan">भ्याट/पान नं</th>
      <th data-data="vendor_address">ठेगाना</th>
      <th data-data="vendor_representative">प्रतिनिधिको नाम</th>
      <th data-data="vendor_phone">फोन</th>
      <th data-data="vendor_email">इमेल</th>
      <th data-data="url" data-orderable="false" data-class-name="all" data-searchable="false" class="skip-export" width="100px"></th>
    </tr>
  </thead>

</table>
</div>
<br>

<%= link_to new_btn.html_safe, new_office_vendor_path %>