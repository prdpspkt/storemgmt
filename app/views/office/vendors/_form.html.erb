  </div>

  <div class="col-sm-6">
    <%= form.label :vendor_name_en %>
    <%= form.text_field :vendor_name_en, class: "form-control" %>
  </div>

  <div class="col-sm-6">
    <%= form.label :vendor_registration %>
    <%= form.text_field :vendor_registration, class: "pcs-nepali form-control" %>
  </div>

  <div class="col-sm-6">
    <%= form.label :vendor_pan %>
    <%= form.text_field :vendor_pan, class: "form-control pcs-nepali" %>
  </div>

  <div class="col-sm-6">
    <%= form.label :vendor_address %>
    <%= form.text_field :vendor_address, class: "preeti form-control" %>
  </div>

  <div class="col-sm-6">
    <%= form.label :vendor_representive %>
    <%= form.text_field :vendor_representative, class: "preeti form-control" %>
  </div>

  <div class="col-sm-6">
    <%= form.label :vendor_phone %>
