<%= form_with(model: office_release_item, local: true) do |form| %>
  <% if office_release_item.errors.any? %>
    <div id="error_explanation">
      <h2><%= pluralize(office_release_item.errors.count, "error") %> prohibited this office_release_item from being saved:</h2>

      <ul>
        <% office_release_item.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>
  <%= form.hidden_field :release_id, value: @office_release.id %>
  <div class="row">
  <div class="col-sm-4">
    <%= form.label :name_of_item %>
    <%= form.select(:item_id, Office::Item.where(item_classification_no: 52).all.collect{ |item| [item.name_of_item_en, item.id]}, {include_blank: "--select--"}, {class: "form-control"}) %>
  </div>

  <div class="col-sm-3">
    <%= form.label :quantity %>
    <%= form.text_field :quantity, class: "form-control" %>
  </div>


  <div class="col-sm-3">
    <%= form.label :remarks %>
    <%= form.text_field :remarks, class: "form-control" %>
  </div>
  <div class="col-sm-2">
    <%= form.submit :save, class: "btn btn-success" %>
  </div>
  </div>
<% end %>
