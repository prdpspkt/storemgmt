<h1>निकासा फाराम</h1>
<div class="table-responsive">
<table class="table table-sm table-condensed table-bordered">
  <tr>
    <th>निकासा नं</th>
    <th>निकासा मिति</th>
    <th>निकासा गर्ने</th>
    <th>स्वीकृत गर्ने</th>
  </tr>
  <tr>
    <td><%= nd @office_release.release_no %></td>
    <td><%= ndate @office_release.release_date %></td>
    <td><%= @office_release.store_body.store_keeper_name %></td>
    <td><%= @office_release.store_body.office_chief_name %></td>
  </tr>
</table>
</div>
<div class="text-center">
  <%= link_to back_btn.html_safe, office_releases_path %>
  <% if @office_release.marked_as_final == false %>
    <%= link_to edit_big_btn.html_safe, edit_office_release_path(@office_release) %>
    <%= link_to final_btn.html_safe, accept_office_release_path(@office_release), method: :post %>
  <% end %>
  <% if @office_release.marked_as_final == true && @office_release.entry_generated == false %>
    <%= link_to before_final_btn.html_safe, accept_office_release_path(@office_release), id: :mark_as_not_final, method: :post %>
    <%= link_to ledger_entry_btn.html_safe, transaction_office_release_path(@office_release), method: :post %>
<% end %>
  <%= link_to print_big_btn.html_safe, print_office_release_path(@office_release, format: :pdf), target: "_blank" %>
</div>
<h2> माग भै आएका सामाग्रीहरू </h2>
<div class="table-responsive">
<table class="table table-sm table-bordered table-condensed">
  <thead>
  <tr>
    <th>जिन्सी खाता पाना नं.</th>
    <th>सामानको नाम</th>
    <th>इकाई</th>
    <th>दर</th>
    <th>परिमाण</th>
    <th>रकम</th>
    <th>कैफियत</th>
    <th></th>
  </tr>
  </thead>
  <tbody>
  <% @office_release_items.each do |item| %>
    <tr id="ori-<%= item.id %>">
      <td><%= nd item.item.item_register_page_no %></td>
      <td><%= item.item.name_of_item_ne %></td>
      <td><%= item.item.unit_ne %></td>
      <td><%= nd item.rate %></td>
      <td><%= nd item.quantity %></td>
      <td><%= nd item.amount %></td>
      <td><%= item.remarks %></td>
      <td>
        <% if @office_release.marked_as_final != true %>
          <%= link_to destroy_btn.html_safe, item, data: {method: :delete} %>
        <% end %></td>
    </tr>
  <% end %>
  </tbody>
</table>
</div>
