<h1>निकासा फाराम</h1>
<table class="table table-sm table-condensed table-bordered">
  <tr>
    <th>निकासा नं</th>
    <th>निकासा मिति</th>
    <th>निकासा गर्ने</th>
    <th>स्वीकृत गर्ने</th>
  </tr>
  <tr>
    <td><%= @office_release.release_no %></td>
    <td><%= @office_release.release_date %></td>
    <td><%= @office_release.store_body.store_keeper_name %></td>
    <td><%= @office_release.store_body.office_chief_name %></td>
  </tr>
</table>
<div class="text-center">
  <%= link_to back_btn.html_safe, office_releases_path %>
  <% if @office_release.marked_as_final != true %>
  <%= link_to edit_big_btn.html_safe, edit_office_release_path(@office_release) %>
  <% end %>
  <%= link_to print_big_btn.html_safe, "/report/office_release/#{@office_release.id}" %>
  <% if @office_release.marked_as_final != true %>
    <%= link_to final_btn.html_safe, "/office_releases/mark_as_final/#{@office_release.id}", method: :post %>
  <% end %>
  <% if can_unmark(@office_release) %>
    <%= link_to before_final_btn.html_safe, "/office_releases/mark_as_final/#{@office_release.id}", id: :mark_as_not_final, method: :post %>
  <% end %>
</div>
<div class="separator"></div>
<% if @office_release.marked_as_final != true %>
<h2>निकासा गर्ने सामाग्री थप गर्ने</h2>
<%= render "office_release_item_form", office_release_item: @office_release_item %>
<div class="separator"></div>
<% end %>
<h2> निकासा गर्न थप गरिएका जिन्सी सामानहरू</h2>
<table class="table table-sm table-bordered table-condensed">
  <thead>
  <tr>
    <th>जिन्सी खाता पाना नं.</th>
    <th>सामानको नाम</th>
    <th>इकाई</th>
    <th>दर</th>
    <th>परिमाण</th>
    <th>रकम</th>
    <th>कैफियत</th>
  </tr>
  </thead>
  <tbody>
  <% @office_release_items.each do |item| %>
  <tr id="ori-<%= item.id %>">
    <td><%= item.item.item_register_page_no %></td>
    <td><%= item.name_of_item_ne %></td>
    <td><%= item.unit_ne %></td>
    <td><%= item.rate %></td>
    <td><%= item.quantity %></td>
    <td><%= item.amount %></td>
    <td><%= item.remarks %></td>
    <td> <% if @office_release.marked_as_final != true %>
      <%= link_to destroy_btn.html_safe, item, data: { method: :delete, remote: true, confirm: "Are you sure ?"} %>
        <% end %></td>
  </tr>
    <% end %>
  </tbody>

</table>
