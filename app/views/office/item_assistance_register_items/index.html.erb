<h1>Item Assistance Register Items</h1>

<table class="responsive nowrap table table-hover" id="dttb-item_assistance_register_items" data-sort="true" data-source="<%= url_for(format: :json)%>">
  <thead>
    <tr>
      <th data-data="date">Date</th>
      <th data-data="order_release_no">Order release no</th>
      <th data-data="name_of_item">Name of item</th>
      <th data-data="specification">Specification</th>
      <th data-data="item_identification_no">Item identification no</th>
      <th data-data="model_no">Model no</th>
      <th data-data="quantity">Quantity</th>
      <th data-data="amount">Amount</th>
      <th data-data="taken_date">Taken date</th>
      <th data-data="date_to_be_returned">Date to be returned</th>
      <th data-data="returned_quantity">Returned quantity</th>
      <th data-data="returned_date">Returned date</th>
      <th data-data="name_of_user">Name of user</th>
      <th data-data="user_id">User</th>
      <th data-data="office_id">Office</th>
      <th data-data="fy">Fy</th>
      <th data-data="fiscal_year_id">Fiscal year</th>
      <th data-data="url" data-orderable="false" data-class-name="all" data-searchable="false" class="skip-export" width="100px"></th>
    </tr>
  </thead>

</table>

<br>

<%= link_to 'New Item Assistance Register Item', new_item_assistance_register_item_path %>