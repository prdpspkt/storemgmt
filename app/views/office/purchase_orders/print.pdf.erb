<table class="table table-wide">
  <tr>
    <td>श्री <%= @purchase_order.vendor.vendor_name %></td>
    <td></td>
    <td>खरिद आदेश नं : <%= nd @purchase_order.order_no %></td>
  </tr>
  <tr>
    <td>आदेश गरिएको व्यक्ति/निकायको नाम: <%= @purchase_order.vendor.vendor_name %></td>
    <td></td>
    <td>खरिद आदेश मिति: <%= ndate @purchase_order.order_date %></td>
  </tr>
  <tr>
    <td>ठेगाना: <%= @purchase_order.vendor.vendor_address %></td>
    <td>फोन नं: <%= nd @purchase_order.vendor.vendor_phone %></td>
    <td>खरिद सम्वन्धि निर्णय नं: <%= nd @purchase_order.order_decision_no %></td>
  </tr>
  <tr>
    <td>संस्था दर्ता नं: <%= nd @purchase_order.vendor.vendor_registration %></td>
    <td>पान नं: <%= nd @purchase_order.vendor.vendor_pan %></td>
    <td>निर्णय मिति: <%= ndate @purchase_order.order_decision_date %></td>
  </tr>
  <tr>
    <td colspan="3"></td>
  </tr>
</table>
<table class="table table-wide black-border">
  <thead>
  <tr class="text-center">
    <td rowspan="2" >क्र.सं.</td>
    <td colspan="5">सामानको</td>
    <td colspan="2">मूल्य</td>
    <td rowspan="2">कैफियत</td>
  </tr>
  <tr class="text-center">
    <td >जिन्सी वर्गीकरण सङ्केत नं</td>
    <td>नाम</td>
    <td>स्पेसिफिकेसन</td>
    <td>इकाई</td>
    <td>परिमाण</td>
    <td>दर</td>
    <td>जम्मा</td>
  </tr>
  <tr class="text-center">
    <td>१</td>
    <td>२</td>
    <td>३</td>
    <td>४</td>
    <td>५</td>
    <td>६</td>
    <td>७</td>
    <td>८</td>
    <td>९</td>
  </tr>
  </thead>
  <tbody>
  <% @i = 1 %>
  <% @total = 0 %>
  <% @vat = 0 %>
  <% @amount = 0 %>
  <% @purchase_order_items.each do |item| %>
  <tr>
    <td class="text-center"><%= nd @i %></td>
    <td class="text-center"><%= nd item.item.item_classification_no %></td>
    <td class="item_name"><%= item.item.name_of_item_ne %></td>
    <td><%= item.item.specification %></td>
    <td><%= item.item.unit_ne %></td>
    <td><%= nd item.quantity %></td>
    <td><%= nd item.rate %></td>
    <td><%= nd item.amount_without_vat %></td>
    <td><%= item.remarks %></td>
    <% if item.is_vatable
      @vat = item.amount_without_vat * 0.13
      @amount = item.amount_without_vat + @vat
      @total = @total + @amount
    else
      @amount = item.amount_without_vat
      @total = @total+@amount
    end %>
  </tr>
    <% @i = @i + 1 %>
    <% end %>
  <tr>
    <td>&nbsp;</td>
    <td>&nbsp;</td>
    <td>&nbsp;</td>
    <td>&nbsp;</td>
    <td>&nbsp;</td>
    <td colspan="2">जम्मा रकम</td>
    <td><%= nd @amount %></td>
    <td>&nbsp;</td>
  </tr>
  <tr>
    <td>&nbsp;</td>
    <td>&nbsp;</td>
    <td>&nbsp;</td>
    <td>&nbsp;</td>
    <td>&nbsp;</td>
    <td colspan="2">मु.अ.कर (१३%)</td>
    <td><%= nd @vat %></td>
    <td>&nbsp;</td>
  </tr>
  <tr>
    <td>&nbsp;</td>
    <td>&nbsp;</td>
    <td>&nbsp;</td>
    <td>&nbsp;</td>
    <td>&nbsp;</td>
    <td colspan="2">कुल जम्मा रकमः</td>
    <td><%= nd @total %></td>
    <td>&nbsp;</td>
  </tr>
  </tbody>
</table>
<table class="table table-wide">
  <tr>
    <td colspan="9">माथि उल्लिखित सामान मिति <%= ndate @purchase_order.date_to_receive_goods %> भित्र  <%= @purchase_order.office.office %>,  <%= @purchase_order.office.address %> स्थानमा दाखिला गरी बिल । इन्भाइस
      प्रस्तुत गर्नुहोला ।
    </td>
  </tr>
  <tr>
    <td colspan="9"></td>
  </tr>

  <tr>
    <td colspan="9">उपर्युक्तअनुसार खरिद आदेश तयार गर्ने, सिफारिस गर्ने र स्वीकृत गर्नेः</td>
  </tr>

  <tr>
    <td colspan="2">फाँटवालाको दस्तखतः</td>
    <td>&nbsp;</td>
    <td colspan="2">शाखा प्रमुखको दस्तखतः</td>
    <td>&nbsp;</td>
    <td colspan="2">कार्लायल प्रमुखको दस्तखतः</td>
    <td>&nbsp;</td>
  </tr>
  <tr>
    <td>नामः</td>
    <td><%= @purchase_order.store_body.store_keeper_name %></td>
    <td>&nbsp;</td>
    <td>नामः</td>
    <td><%= @purchase_order.store_body.section_chief_name %></td>
    <td>&nbsp;</td>
    <td>नामः</td>
    <td><%= @purchase_order.store_body.office_chief_name %></td>
    <td>&nbsp;</td>
  </tr>
  <tr>
    <td>मितिः</td>
    <td><%= ndate @purchase_order.store_chief_signed_date %></td>
    <td>&nbsp;</td>
    <td>मितिः</td>
    <td><%= ndate @purchase_order.section_chief_signed_date %></td>
    <td>&nbsp;</td>
    <td>मितिः</td>
    <td><%= ndate @purchase_order.office_chief_signed_date %></td>
    <td>&nbsp;</td>
  </tr>
<tr>
  <td colspan="9"></td>
</tr>
  <tr>
    <td colspan="9">माथि उल्लिखित सामानहरू मिति <%= ndate @purchase_order.date_to_receive_goods %> भित्र <%= @purchase_order.office.office %> कार्यालयमा बुझाउने छु भनी सहिछाप गर्ने ।</td>
  </tr>
<tr>
  <td colspan="9"></td>
</tr>
  <tr>
    <td>फर्मको नाम</td>
    <td> <%= @purchase_order.vendor.vendor_name %></td>
    <td>&nbsp;</td>
    <td>दस्तखत र छाप</td>
    <td>&nbsp;</td>
    <td>&nbsp;</td>
    <td>मिति</td>
    <td>&nbsp;</td>
    <td>&nbsp;</td>
  </tr>

</table>