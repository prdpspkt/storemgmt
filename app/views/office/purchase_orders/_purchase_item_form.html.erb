<%= form_with(model: purchase_order_item, local: true) do |form| %>
  <% if purchase_order_item.errors.any? %>
    <div id="error_explanation">
      <h2><%= pluralize(purchase_order_item.errors.count, "error") %> prohibited this purchase_order_item from being saved:</h2>

      <ul>
        <% purchase_order_item.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>
  <%= form.hidden_field :purchase_order_id, value: @purchase_order.id %>
  <div class="row">
    <div class="col-sm-2">
      <%= form.label :item_classification_no %>
      <%= form.number_field :item_classification_no, class: "form-control" %>
    </div>

    <div class="col-sm-4">
      <%= form.label :name_of_item %>
      <%= form.select(:office_item_id, Office::Item.all.collect {|item| [item.name_of_item_en, item.id]}, {include_blank: "select"}, {class: "form-control"}) %>
    </div>

    <div class="col-sm-1">
      <%= form.label :quantity %>
      <%= form.text_field :quantity, class: "form-control" %>
    </div>

    <div class="col-sm-1">
      <%= form.label :rate %>
      <%= form.text_field :rate, class: "form-control" %>
    </div>

    <div class="col-sm-3">
      <%= form.label :remarks %>
      <%= form.text_field :remarks, class: "preeti form-control" %>
    </div>
    <div class="col-sm-1">
      <br>
      <%= form.submit :save, class: "btn btn-success" %>
    </div>
  </div>
<% end %>
