<%= form_with(model: purchase_order_item, local: true) do |form| %>
  <% if purchase_order_item.errors.any? %>
    <div id="error_explanation">
      <h2><%= pluralize(purchase_order_item.errors.count, "error") %> prohibited this purchase_order_item from being saved:</h2>

      <ul>
        <% purchase_order_item.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>
  <%= form.hidden_field :purchase_order_id, value: @purchase_order.id %>
  <div class="row">

    <div class="col-sm-4">
      <%= form.label :name_of_item %>
      <%= form.select(:item_id, @items.collect {|item| [item.name_of_item_en, item.id]}, {include_blank: "select"}, {class: "form-control select2", required: :required}) %>
    </div>

    <div class="col-sm-2">
      <%= form.label :quantity %>
      <%= form.number_field :quantity, class: "form-control", required: :required, step: :any %>
    </div>

    <div class="col-sm-2">
      <%= form.label :rate %>
      <%= form.number_field :rate, class: "form-control", required: :required, step: :any %>
    </div>
    <div class="col-sm-2">
      <%= form.label :is_vatable %>
      <%= form.check_box :is_vatable, class: "form-control", :checked => true %>
    </div>
    <div class="col-sm-2">
      <%= form.label :remarks %>
      <%= form.text_field :remarks, class: "preeti form-control" %>
    </div>
  </div>
 <div class="separator"></div>
      <%= form.submit :save, class: "btn btn-success float-right" %>

<% end %>
