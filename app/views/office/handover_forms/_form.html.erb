<%= form_with(model: handover_form, local: true) do |form| %>
  <% if handover_form.errors.any? %>
    <div id="error_explanation">
      <h2><%= pluralize(handover_form.errors.count, "error") %> prohibited this handover_form from being saved:</h2>

      <ul>
      <% handover_form.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
      </ul>
    </div>
  <% end %>
<div class="row">
    <div class="col-6">
