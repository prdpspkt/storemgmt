<table class="table">
  <tr>
    <td colspan="12">यस कार्यालयको तपसिल अनुसारको मालसामान हस्तान्तरण गरिएको छ ।</td>
  </tr>
  <tr>
    <td colspan="12">सामान हस्तान्तरण गर्ने निर्णय नं: <%= nd @office_handover_form.decision_no %></td>
  </tr>
  <tr>
    <td colspan="9">सामान हस्तान्तरण गर्ने निर्णय मितिः <%= ndate @office_handover_form.decision_date %></td>
    <td >मिति: <%= ndate @office_handover_form.date %></td>
  </tr>
  <tr>
    <td colspan="9">सामान हस्तान्तरण गरिएको कार्यालयको नामः <%= @office_handover_form.handovered_office_name %></td>
    <td >हस्तान्तरण फारम नं: <%= nd @office_handover_form.form_no %></td>
  </tr>
</table>
<table class="table black-border">
