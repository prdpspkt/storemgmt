    <td>१०</td>
    <td>११</td>
    <td>१२</td>
  </tr>
  </thead>
  <tbody>
  <% @id = 1 %>
  <% @office_handover_form_items.each do |item| %>
  <tr>
    <td><%= nd @id %></td>
    <td><%= nd item.item.item_classification_no %></td>
    <td><%= nd item.item.item_register_page_no %></td>
    <td><%= item.item.name_of_item_ne %></td>
    <td><%= item.specification %></td>
    <td><%= item.item_identification_no %></td>
    <td><%= item.model_no %></td>
    <td><%= item.item.unit_ne %></td>
    <td><%= nd item.quantity %></td>
    <td><%= nd item.amount %></td>
    <td><%= ndate item.received_date %></td>
    <td><%= item.physical_status %></td>
  </tr>
  <% @id = @id + 1 %>
    <% end %>
  </tbody>
</table>
