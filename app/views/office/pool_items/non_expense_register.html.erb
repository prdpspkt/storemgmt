<div class="row no-print">
  <div class="col-12 text-center">
    <%= link_to back_btn.html_safe, non_expense_index_office_items_url %>
  </div>
</div>
<table class="table  table-responsiive table-sm table-borderless">
  <tr class="text-center">
    <td colspan="17" class="gov_name"><%= @office.gov %></td>
  </tr>
  <tr class="text-center">
    <td colspan="17" class="min_name"><%= @office.ministry %></td>
  </tr>
  <tr class="text-center">
    <td colspan="17" class="off_name"><%= @office.office %></td>
  </tr>
  <tr class="text-center">
    <td colspan="17" class="min_name"><%= @office.address %></td>
  </tr>
  <tr class="text-center">
    <td colspan="17" class="min_name">कार्यालयको कोड: <%= @office.code %></td>
  </tr>
  <tr class="text-center">
    <td colspan="17" class="off_name">खर्च भएर नजाने (खप्ने) सामानको जिन्सी खाता</td>
  </tr>
</table>
<table class="table table-responsive  table-borderless table-sm">
  <tr>
    <td>जिन्सी सामानको नामः</td>
    <td colspan="2">
      <%= @item.name_of_item_ne %>
    </td>
    <td>आर्थिक वर्षः</td>
    <td><%= @fiscal_year.fy %></td>
  </tr>
  <tr>
    <td>इकाई:</td>
    <td><%= @item.unit_ne %></td>
    <td>&nbsp;</td>
    <td>जिन्सी सङ्केत नं:</td>
    <td><%= nd @item.item_classification_no %></td>
  </tr>
  <tr>
    <td>&nbsp;</td>
    <td>&nbsp;</td>
    <td>&nbsp;</td>
    <td>जिन्सी खाता पाना नं:</td>
    <td><%= nd @item.item_register_page_no %></td>
  </tr>
</table>
<table class="table table-responsive table-sm table-black-border">
  <tr class="text-center">
    <td rowspan="2">मिति</td>
    <td rowspan="2">दाखिला नं/हस्तान्तरण नं</td>
    <td rowspan="2">स्पेसिफिकेसन</td>
    <td rowspan="2">सामानको पहिचान नं</td>
    <td rowspan="2">मोडल नं</td>
    <td colspan="4">विवरण</td>
    <td colspan="3">आम्दानी</td>
    <td colspan="2">हस्तान्तरण/मिन्हा/निःसर्ग</td>
    <td colspan="2">बाँकी</td>
    <td rowspan="2">कैफियत</td>
  </tr>
  <tr class="text-center">
    <td>उत्पादन गर्ने देश वा कम्पनीको नाम</td>
    <td>साइज</td>
    <td>अनुमानित आयु</td>
    <td>सामान प्राप्तिको स्रोत</td>
    <td>परिमाण</td>
    <td>प्रति एकाइको दर</td>
    <td>जम्मा परल मूल्य</td>
    <td>परिमाण</td>
    <td>जम्मा परल मूल्य</td>
    <td>परिमाण</td>
    <td>जम्मा परल मूल्य</td>
  </tr>
  <tr>
    <td>१</td>
    <td>२</td>
    <td>३</td>
    <td>४</td>
    <td>५</td>
    <td>६</td>
    <td>७</td>
    <td>८</td>
    <td>९</td>
    <td>१०</td>
    <td>११</td>
    <td>१२</td>
    <td>१३</td>
    <td>१४</td>
    <td>१५</td>
    <td>१६</td>
    <td>१७</td>
  </tr>
  <% @transactions = @item.item_transactions %>
    <% @qty = 0.00 %>
    <% @amt = 0.00 %>
    <% @transactions.each do |t| %>
      <tr>
        <td><%= ndate t.transaction_date %></td>
        <td><%= nd  t.entry_no %></td>
        <td><%= t.item.specification %></td>
        <td><%= t.item_identification_no %></td>
        <td><%= t.model %></td>
        <td><%= t.country %></td>
        <td><%= t.size %></td>
        <td><%= t.approx_age %></td>
        <td><%= t.source %></td>
        <% if t.transaction_type > 0 %>
          <% @qty = @qty + t.quantity %>
          <% @amt = @amt + t.amount %>
          <td><%= nd t.quantity %></td>
          <td><%= nd t.rate %></td>
          <td><%= nd t.amount %></td>
          <td></td>
          <td>&nbsp;</td>
          <td><%= nd @qty %></td>
          <td><%= nd @amt %></td>
        <% end %>
        <% if t.transaction_type < 0 %>
          <% @qty = @qty - t.quantity %>
          <% @amt = @amt - t.amount %>
          <td></td>
          <td>&nbsp;</td>
          <td>&nbsp;</td>
          <td><%= nd t.quantity %></td>
          <td><%= nd t.amount %></td>
          <td><%= nd @qty %></td>
          <td><%= nd @amt %></td>
        <% end %>
        <td><%= t.remarks %></td>
      </tr>
    <% end %>
</table>
<table class="table  table-sm table-borderless">
  <tr>
    <td>फाँटवालाको दस्तखतः </td>
    <td>&nbsp;</td>
    <td>&nbsp;</td>
    <td>&nbsp;</td>
    <td>शाखा प्रमुखको दस्तखतः</td>
    <td>&nbsp;</td>
    <td>&nbsp;</td>
    <td>&nbsp;</td>
    <td>कार्यालय प्रमुखको दस्तखतः</td>
    <td>&nbsp;</td>
    <td>&nbsp;</td>
    <td>&nbsp;</td>
  </tr>
  <tr>
    <td>नामः <%= @cb.store_keeper_name  %></td>
    <td>&nbsp;</td>
    <td>&nbsp;</td>
    <td>&nbsp;</td>
    <td>नामः <%= @cb.section_chief_name %></td>
    <td>&nbsp;</td>
    <td>&nbsp;</td>
    <td>&nbsp;</td>
    <td>नामः <%= @cb.office_chief_name %></td>
    <td>&nbsp;</td>
    <td>&nbsp;</td>
    <td>&nbsp;</td>
  </tr>
  <tr>
    <td>पदः <%= @cb.store_keeper_designation %></td>
    <td>&nbsp;</td>
    <td>&nbsp;</td>
    <td>&nbsp;</td>
    <td>पदः <%= @cb.section_chief_designation %></td>
    <td>&nbsp;</td>
    <td>&nbsp;</td>
    <td>&nbsp;</td>
    <td>पदः <%= @cb.office_chief_designation %></td>
    <td>&nbsp;</td>
    <td>&nbsp;</td>
    <td>&nbsp;</td>
  </tr>
  <tr>
    <td>मितिः <%= ndate @fiscal_year.closing_date %></td>
    <td>&nbsp;</td>
    <td>&nbsp;</td>
    <td>&nbsp;</td>
    <td>मितिः <%= ndate @fiscal_year.closing_date %></td>
    <td>&nbsp;</td>
    <td>&nbsp;</td>
    <td>&nbsp;</td>
    <td>मितिः <%= ndate @fiscal_year.closing_date %></td>
    <td>&nbsp;</td>
    <td>&nbsp;</td>
    <td></td>
  </tr>
  </tbody>
</table>