<h1>Item Disposal Items</h1>

<table class="responsive nowrap table table-hover" id="dttb-item_disposal_items" data-sort="true" data-source="<%= url_for(format: :json)%>">
  <thead>
    <tr>
      <th data-data="item_classification_no">Item classification no</th>
      <th data-data="item_register_page_no">Item register page no</th>
      <th data-data="item_id">Item</th>
      <th data-data="is_office_item">Is office item</th>
      <th data-data="is_project_item">Is project item</th>
      <th data-data="specification">Specification</th>
      <th data-data="received_date">Received date</th>
      <th data-data="used_year">Used year</th>
      <th data-data="quantity">Quantity</th>
      <th data-data="amount">Amount</th>
      <th data-data="current_marked_price">Current marked price</th>
      <th data-data="reason_for_disposal">Reason for disposal</th>
      <th data-data="remarks">Remarks</th>
      <th data-data="office_id">Office</th>
      <th data-data="user_id">User</th>
      <th data-data="fy">Fy</th>
      <th data-data="fiscal_year_id">Fiscal year</th>
      <th data-data="url" data-orderable="false" data-class-name="all" data-searchable="false" class="skip-export" width="100px"></th>
    </tr>
  </thead>

</table>

<br>

<%= link_to 'New Item Disposal Item', new_item_disposal_item_path %>