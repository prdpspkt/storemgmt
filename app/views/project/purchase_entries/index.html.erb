<div class="row">
  <div class="col-md-4">
    <h1>जिन्सी दाखिला प्रतिवेदनहरू</h1>
  </div>
  <div class="col-md-8">
    <div class="imex float-right">
      <%= link_to new_btn.html_safe, new_project_purchase_entry_path %>
    </div>
  </div>
</div>

<div class="table-responsive">
  <table class="table table-sm  data-table" id="dttb-office_entries" data-sort="true" data-source="<%= url_for(format: :json) %>">
    <thead>
    <tr>
      <th data-data="serial">क्र.स.</th>
      <th data-data="entry_no">दाखिला नं</th>
      <th data-data="entry_date">दाखिला मिति</th>
      <th data-data="url" data-orderable="false" data-class-name="all" data-searchable="false" class="skip-export" width="100px"></th>
    </tr>
    </thead>

  </table>
</div>