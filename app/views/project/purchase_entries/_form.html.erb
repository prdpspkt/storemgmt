<%= form_with(model: purchase_entry, local: true) do |form| %>
  <% if purchase_entry.errors.any? %>
    <div id="error_explanation">
      <h2><%= pluralize(purchase_entry.errors.count, "error") %> prohibited this purchase_entry from being saved:</h2>

      <ul>
      <% purchase_entry.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
      </ul>
    </div>
  <% end %>
<div class="row">
  <div class="col-sm-6">
    <%= form.label :purchase_handover_no %>
    <%= form.text_field :purchase_handover_no, class: "form-control", required: :required %>
  </div>
  <div class="col-sm-6">
    <%= form.label :entry_date %>
    <%= form.text_field :entry_date, class: "form-control date-picker", required: :required %>
  </div>

  <div class="col-sm-6">
    <%= form.label :entry_no %>
    <%= form.number_field :entry_no, class: "form-control", readonly: :readonly %>
  </div>
  
  <div class="col-sm-6">
    <%= form.label :store_cheif_sign_date %>
    <%= form.text_field :store_chief_signed_date, class: "form-control date-picker", required: :required %>
  </div>


  <div class="col-sm-6">
    <%= form.label :section_chief_signed_date %>
    <%= form.text_field :section_chief_signed_date, class: "form-control date-picker", required: :required %>
  </div>


  <div class="col-sm-6">
    <%= form.label :chief_signed_date %>
    <%= form.text_field :chief_signed_date, class: "form-control date-picker", required: :required %>
  </div>
</div>
  <div class="separator"></div>
  <div class="pull-right">
    <%= form.submit :save, class: "btn btn-success" %>
  </div>
<% end %>
