<h1>खरिद आदेशहरू</h1>

<table class="table table-sm table-condensed data-table" id="dttb-purchase_orders" data-sort="true" data-source="<%= url_for(format: :json)%>">
  <thead>
    <tr>
      <th data-data="order_no">खरिद आदेश नं</th>
      <th data-data="order_date">आदेश मिति</th>
      <th data-data="vendor_name">आदेश पाउने संस्था</th>
      <th data-data="vendor_address">संस्थाको ठेगाना</th>
      <th data-data="url" data-orderable="false" data-class-name="all" data-searchable="false" class="skip-export" width="100px"></th>
    </tr>
  </thead>

</table>

<br>

<%= link_to new_btn.html_safe, new_office_purchase_order_path %>