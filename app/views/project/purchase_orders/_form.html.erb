<%= form_with(model: project_purchase_order, local: true) do |form| %>
  <% if project_purchase_order.errors.any? %>
    <div id="error_explanation">
      <h2><%= pluralize(project_purchase_order.errors.count, "error") %> prohibited this project_purchase_order from being saved:</h2>

      <ul>
      <% project_purchase_order.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
      </ul>
    </div>
  <% end %>
<div class="row">
  <div class="col-6">
    <%= form.label :vendor_name %>
    <%= form.select(:vendor_id, @vendors.all.collect { |v| [v.vendor_name, v.id]}, {include_blank: true}, {class: "form-control", required: :require }) %>
  </div>

  <div class="col-6">
    <%= form.label :order_no %>
    <%= form.text_field :order_no, class: "form-control" %>
  </div>

  <div class="col-6">
    <%= form.label :order_date %>
    <%= form.text_field :order_date, class: "form-control date-picker" %>
  </div>

  <div class="col-6">
    <%= form.label :order_decision_no %>
    <%= form.number_field :order_decision_no, class: "form-control" %>
  </div>

  <div class="col-6">
    <%= form.label :order_decision_date %>
    <%= form.text_field :order_decision_date, class: "form-control date-picker" %>
  </div>
</div>
  <div class="separator"></div>
  <div class="actions">
    <%= form.submit :save, class: "btn btn-success float-right" %>
  </div>
<% end %>
