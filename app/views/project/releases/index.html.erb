<h1>निकासा फारामहरू</h1>
<div class="table-responsive">
<table class="responsive nowrap table table-hover data-table" id="dttb-office_releases" data-sort="true" data-source="<%= url_for(format: :json)%>">
  <thead>
    <tr>
      <th data-data="release_no">निकासा नं</th>
      <th data-data="release_date">निकासा मिति</th>
      <th data-data="url" data-orderable="false" data-class-name="all" data-searchable="false" class="skip-export" width="100px"></th>
    </tr>
  </thead>

</table>
</div>
<br>

<%= link_to new_btn.html_safe, new_office_release_path %>