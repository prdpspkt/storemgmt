<div class="table-responsive">
  <table class="table table-borderless table-sm">
    <tbody>
    <tr>
      <td colspan="10" class="text-center gov_name"><%= @office.gov %></td>
    </tr>
    <tr>
      <td colspan="10" class="text-center min_name"><%= @office.ministry %></td>
    </tr>
    <tr>
      <td colspan="10" class="text-center off_name"><%= @office.office %></td>
    </tr>
    <tr>
      <td colspan="10" class="text-center min_name"><%= @office.address %></td>
    </tr>
    <tr>
      <td colspan="10" class="text-center gov_name"><%= @office.code %></td>
    </tr>
    <tr>
      <td colspan="10" class="text-center off_name">खर्च/निकासा फाराम</td>
    </tr>
    </tbody>
  </table>
  <div class="row">
    <div class="col-12 text-right">
      आ.व.: <%= @project_release.fiscal_year.fy %><br>निकाशा नं: <%= nd @project_release.release_no %><br> निकाशा
      मिति: <%= ndate @project_release.release_date %>
    </div>
  </div>
  <table class="table table-bordered table-sm">
    <tr>
      <td>क्र.सं.</td>
      <td>सामानको नाम</td>
      <td>कोड नं</td>
      <td>स्पेसिफिकेसन</td>
      <td>निकासा गरिएको</td>
      <td></td>
      <td></td>
      <td>जम्मा रकम</td>
      <td>जिन्सी खाता पाना नम्बर</td>
      <td>कैफियत</td>
    </tr>
    <tr>
      <td></td>
      <td></td>
      <td></td>
      <td></td>
      <td>एकाइ</td>
      <td>परिमाण</td>
      <td>दर</td>
      <td></td>
      <td></td>
      <td></td>
    </tr>
    <tr>
      <td>१</td>
      <td>२</td>
      <td>३</td>
      <td>४</td>
      <td>५</td>
      <td>६</td>
      <td>७</td>
      <td>८=६*७</td>
      <td>९</td>
      <td>१०</td>
    </tr>
    <% @i = 1 %>
    <% @project_release_items.each do |item| %>
      <tr>
        <td><%= nd @i %></td>
        <td><%= item.item.name_of_item_ne %></td>
        <td><%= nd item.item.item_classification_no %></td>
        <td><%= item.item.specification %></td>
        <td><%= item.item.unit_ne %></td>
        <td><%= nd item.quantity %></td>
        <td><%= nd item.rate %></td>
        <td><%= nd item.amount %></td>
        <td><%= nd item.item.item_register_page_no %></td>
        <td><%= item.remarks %></td>
      </tr>
    <% end %>
  </table>
  <table class="table table-borderless table-sm table-condensed">
    <tr>
      <td></td>
      <td>स्टोर शाखाको दस्तखतः</td>
      <td></td>
      <td></td>
      <td></td>
      <td></td>
      <td></td>
      <td>स्वीकृत गर्नेको दस्तखतः</td>
      <td></td>
      <td></td>
    </tr>
    <tr>
      <td></td>
      <td>नामः</td>
      <td><%= @project_release.store_body.store_keeper_name %></td>
      <td></td>
      <td></td>
      <td></td>
      <td></td>
      <td>नामः</td>
      <td><%= @project_release.store_body.office_chief_name %></td>
      <td></td>
    </tr>
    <tr>
      <td></td>
      <td>मितिः</td>
      <td><%= ndate @project_release.store_chief_signed_date %></td>
      <td></td>
      <td></td>
      <td></td>
      <td></td>
      <td>मितिः</td>
      <td><%= ndate @project_release.office_chief_signed_date %></td>
      <td></td>
    </tr>
  </table>
</div>