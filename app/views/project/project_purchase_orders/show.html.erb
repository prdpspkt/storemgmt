<h1>खरिद आदेश (आयोजना तर्फ)</h1>
<table class="table table-bordered">
  <tr>
    <th>आदेश मिति</th>
    <th>आदेश नं</th>
    <th>निर्णय मिति</th>
    <th>निर्णय नं</th>
    <th>आदेश पाउने</th>
    <th>आदेश पाउनेको फोन नं</th>
  </tr>
  <tr>
    <td><%= ndate @project_purchase_order.order_date %></td>
    <td><%= nd @project_purchase_order.order_no %></td>
    <td><%= ndate @project_purchase_order.order_decision_date %></td>
    <td><%= nd @project_purchase_order.order_decision_no %></td>
    <td><%= @project_purchase_order.vendor_name %>, <%= @project_purchase_order.vendor_address %></td>
    <td><%= nd @project_purchase_order.vendor_phone %></td>
  </tr>
</table>
<div class="text-center">
  <%= link_to back_btn.html_safe, project_purchase_orders_path %>
  <% if @project_purchase_order.marked_as_final != true %>
    <%= link_to edit_big_btn.html_safe, edit_project_purchase_order_path(@project_purchase_order) %>
    <%= link_to final_btn.html_safe, ppo_maf_path(@project_purchase_order), data: { method: :post} %>
  <% end %>
  <% if can_unmark @project_purchase_order %>
    <%= link_to before_final_btn.html_safe, ppo_maf_path(@project_purchase_order), data: {method: :post} %>
  <% end %>
  <%= link_to print_big_btn.html_safe, project_purchase_orders_path %>
</div>
<div class="separator"></div>
<h2>सामग्री थप गर्ने</h2>
<%= render 'project_purchase_orders/project_purchase_order_form', project_purchase_order_item: @project_purchase_order_item %>
<div class="separator"></div>
<table class="table table-sm">
  <tr>
    <th>क्र.स.</th>
    <th>जिन्सी वर्गीकरण नं</th>
    <th>सामानको नाम</th>
    <th>इकाई</th>
    <th>परिमाण</th>
    <th>दर</th>
    <th>रकम</th>
    <th>कैफियत</th>
  </tr>
  <% @i = 1 %>
  <% @project_purchase_order_items.each do |item| %>
    <tr>
      <td><%= nd @i %></td>
      <td><%= nd item.item_classification_no %></td>
      <td><%= item.name_of_item_ne %></td>
      <td><%= item.unit_ne %></td>
      <td><%= nd item.quantity %></td>
      <td><%= nd item.rate %></td>
      <td><%= nd item.amount %></td>
      <td><%= item.remarks %></td>
    </tr>
    <% @i = @i + 1 %>
  <% end %>
  <tr>
    <td></td>
    <td></td>
    <td></td>
    <td></td>
    <td></td>
    <td>जम्मा भ्याट सहित</td>
    <td><%= nd @project_purchase_order_items.sum(:amount) %></td>
    <td></td>
  </tr>
</table>