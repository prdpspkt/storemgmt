<%= form_with(model: project_tender_breakdown_item, local: true) do |form| %>
  <% if project_tender_breakdown_item.errors.any? %>
    <div id="error_explanation">
      <h2><%= pluralize(project_tender_breakdown_item.errors.count, "error") %> prohibited this project_tender_breakdown_item from being saved:</h2>

      <ul>
        <% project_tender_breakdown_item.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>
  <%= form.hidden_field :project_tender_breakdown_id %>
<div class="row">
  <div class="col-2">
    <label>सामानको प्रकार</label>
    <select name="item_classification_no" id="item_classification_no", class="form-control" required="required">
      <option>छान्नुहोस्</option>
      <option value="52">खर्च भएर जाने</option>
      <option value="47">खर्च भएर नजाने</option>
    </select>
  </div>
  <div class="col-6">
    <%= form.label "सामानको नाम" %>
    <%= form.select(:project_item_id, @project_items.collect{|item|[item.name_of_item_ne, item.id]}, {include_blank: "सामानको नाम छान्नुहोस्"}, {class: "form-control", id: "project-item-holder"}) %>

  </div>

  <div class="col-3">
    <%= form.label :"परिमाण" %>
    <%= form.text_field :quantity, class: "form-control", required: :required %>
  </div>
</div>
  <div class="float-right">
    <%= form.submit :save, class: "btn btn-success" %>
  </div>
<% end %>
