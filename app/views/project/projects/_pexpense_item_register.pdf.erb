<table class="table">
  <tr>
    <td colspan="2">आयोजनाको नाम: <%= @project.name_of_project_ne %></td>
    <td>आर्थिक वर्षः <%= @fiscal_year.fy %></td>
  </tr>
  <tr>
    <td colspan="2">जिन्सी सामानको नामः  <%= item.name_of_item_ne %></td>
    <td colspan="2">जिन्सी सङ्केत नं: <%= nd item.item_classification_no %></td>
  </tr>
  <tr>
    <td>इकाई: <%= item.unit_ne %></td>
    <td></td>
    <td colspan="2">जिन्सी खाता पाना नं: <%= nd item.item_register_page_no %></td>
  </tr>
  <tr>
    <td></td>
  </tr>
</table>
<table class="table black-border table-wide">
  <thead>
  <tr class="text-center">
    <td rowspan="2">मितिः</td>
    <td rowspan="2">दाखिला / निकासा नं</td>
    <td colspan="3">स्टोर दाखिला (आम्दानी)</td>
    <td colspan="3">निकासा (खर्च)</td>
    <td colspan="3">बाँकी</td>
    <td rowspan="2">कैफियत</td>
  </tr>
  <tr class="text-center">
    <td>परिमाण</td>
    <td>दर</td>
    <td>रकम</td>
    <td>परिमाण</td>
    <td>दर</td>
    <td>रकम</td>
    <td>परिमाण</td>
    <td>दर</td>
    <td>रकम</td>
  </tr>
  <tr>
    <td>१</td>
    <td>२</td>
    <td>३</td>
    <td>४</td>
    <td>५</td>
    <td>६</td>
    <td>७</td>
    <td>८</td>
    <td>९</td>
    <td>१०</td>
    <td>११</td>
    <td>१२</td>
  </tr>
  </thead>
  <tbody>
  <% @qty = 0 %>
  <% @amt = 0 %>
  <% item.project_item_transactions.where(fiscal_year_id: @fiscal_year.id).each do |transaction| %>
    <% if transaction.transaction_type > 0 %>
      <% @qty = @qty + transaction.quantity %>
      <% @amt = @amt + transaction.amount %>
      <tr>
        <td><%= ndate transaction.transaction_date %></td>
        <td><%= nd transaction.entry_no %></td>
        <td><%= nd transaction.quantity %></td>
        <td><%= nd transaction.rate %></td>
        <td><%= nd transaction.amount %></td>
        <td>&nbsp;</td>
        <td>&nbsp;</td>
        <td>&nbsp;</td>
        <td>&nbsp;<%= nd @qty %></td>
        <td>&nbsp;</td>
        <td><%= nd @amt %></td>
        <td><%= transaction.remarks %></td>
      </tr>
    <% end %>
    <% if transaction.transaction_type < 0 %>
      <% @qty = @qty - transaction.quantity %>
      <% @amt = @amt - transaction.amount %>
      <tr>
        <td><%= ndate transaction.transaction_date %></td>
        <td><%= nd transaction.entry_no %></td>
        <td></td>
        <td></td>
        <td></td>
        <td><%= nd transaction.quantity %></td>
        <td><%= nd transaction.rate %></td>
        <td><%= nd transaction.amount %></td>
        <td>&nbsp;<%= nd @qty %></td>
        <td>&nbsp;</td>
        <td><%= nd @amt %></td>
        <td><%= transaction.remarks %></td>
      </tr>
    <% end %>
  <% end %>
  </tbody>
</table>
