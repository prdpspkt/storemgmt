<% @sn = 1 %>
<% @html_data = " " %>
<% @data.each do |datam| %>
<% if datam[:quantity] < @quantity %>
<% @the_quantity = datam[:quantity] %>
<% else %>
<% @the_quantity = @quantity %>
<% end %>
<% @html_data = @html_data + '<tr>'+
                 '<td>'+@sn.to_s+'</d>' +
                 '<td>'+ datam[:name_of_project_ne] + '</d>' +
                 '<td>'+ datam[:quantity].to_s + '</d>' +
                 '<td id= "item-'+ datam[:from].to_s+'">'+ link_to(create_sapati_btn.html_safe, sapati_create_project_project_path(@project_id, sapati: {to: @project_id, from: datam[:from], item_id: datam[:item_id], quantity: @the_quantity}) , data: {method: :post, remote: true, confirm: "Are you sure you want to take sapati ?"})+ '</td>' +
                 '</tr>' %>
<% @sn = @sn + 1 %>
<% end %>
var data = '<%= @html_data.html_safe %>'
$("#display-table").html(data);
$(".progress_bar").hide();