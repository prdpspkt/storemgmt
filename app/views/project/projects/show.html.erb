<div>
  <span class="h3"><%= @project.name_of_project_ne %></span>
  <%= link_to edit_big_btn.html_safe, edit_project_project_path(@project) %>
  <%= link_to expense_item_ledger_btn.html_safe, expense_item_register_project_project_url(@project) %>
  <%= link_to non_expense_item_ledger_btn.html_safe, non_expense_item_register_project_project_url(@project) %>
  <a class="btn btn-warning" data-toggle="collapse" href="#project_description_table" aria-expanded="false" aria-controls="project_description_table">आयोजनाको
    विवरण</a>
</div>
<div class="separator"></div>
<div id="project_description_table" class="row collapse">
  <div class="col-12">
    <table class="table table-sm table-bordered">
      <tr>
        <th>आयोजनाको नाम:</th>
        <td><%= @project.name_of_project_ne %></td>
        <th>Name of Project</th>
        <td><%= @project.name_of_project_en %></td>
      </tr>
      <tr>
        <th>उपभोक्ता समितिको नाम:</th>
        <td><%= @project.name_of_consumer_committee %></td>
        <th>ठेगाना:</th>
        <td><%= @project.address %></td>
      </tr>
      <tr>
        <th>समिति प्रतिनिधिको नाम:</th>
        <td><%= @project.name_of_committee_representative %> (<%= @project.post_of_representative %>)</td>
        <th>समिति प्रतिनिधिको सम्पर्क नं</th>
        <td><%= @project.phone_of_committee_representative %></td>
      </tr>

      <tr>
        <th>ठेकेदारको नाम:</th>
        <td><%= @project.contractor %></td>
        <th>ठेकेदार प्रतिनिधिको नाम</th>
        <td><%= @project.name_of_contractor_representative %></td>
      </tr>

      <tr>
        <th>ठेकेदारको फोन</th>
        <td><%= @project.phone_of_contractor_representative %></td>
        <th>आयोजनाको अवस्था</th>
        <td><%= @project.project_status %></td>
      </tr>
    </table>
    <div class="separator"></div>
  </div>
</div>

<!-- Nav tabs -->
<ul class="nav nav-tabs">
  <li class="nav-item">
    <a class="nav-link active" data-toggle="tab" href="#home">खर्च भएर जाने जिन्सी</a>
  </li>
  <li class="nav-item">
    <a class="nav-link" data-toggle="tab" href="#menu1">खर्च भएर नजाने(खप्ने) जिन्सी </a>
  </li>
  <li class="nav-item">
    <a class="nav-link" data-toggle="tab" href="#menu2">माग फारामहरू</a>
  </li>
  <li class="nav-item">
    <a class="nav-link" data-toggle="tab" href="#menu3">निकाशा फारामहरू</a>
  </li>
</ul>
<!-- Tab panes -->
<div class="tab-content">
  <div id="home" class="container tab-pane active"> <br>
    <% if  @project.office.sapati %>
    <div class="text-right">
      <%= link_to sapati_btn.html_safe,  sapati_project_project_url(@project) %>
      <%= link_to sapati_return_btn.html_safe, project_sapati_records_url %>
    </div>
    <% end %>
    <h3>खर्च भएर जाने जिन्सी सामान</h3>
    <div class="table-responsive">
      <table class="table data-table table-sm table-bordered">
        <thead>
        <tr>
          <th>क्र.स.</th>
          <th>खाता पाना नं</th>
          <th>सामानको नाम</th>
          <th>Name of Item</th>
          <th>परिमाण</th>
          <th>इकाई</th>
        </tr>
        </thead>
        <tbody>
        <% @i = 1 %>
        <% @project_items52.each do |item| %>
        <% quantity = get_project_item_quantity(@office.id, @fiscal_year.id, item.id, 52)  %>
          <% if quantity > 0  %>
          <tr>
            <td><%= @i %></td>
            <td><%= nd item.item_register_page_no %></td>
            <td><%= item.name_of_item_ne %></td>
            <td><%= item.name_of_item_en %></td>
            <td><%= nd quantity %></td>
            <td><%= item.unit_ne %></td>
          </tr>
          <% @i = @i + 1 %>
        <% end %>
        <% end %>
        </tbody>
      </table>
    </div>
  </div>
  <div id="menu1" class="container tab-pane fade"><br>
       <% if @project.office.sapati %>
    <div class="text-right">
      <%= link_to sapati_btn.html_safe, "#" %>
      <%= link_to sapati_return_btn.html_safe, "#" %>
    </div>
    <% end %>
    <h3>खर्च भएर नजाने (खप्ने) जिन्सी सामानहरू</h3>
    <div class="table-responsive">
      <table class="table table-sm data-table table-bordered">
        <thead>
        <tr>
          <th>क्र.स.</th>
          <th>खाता पाना नं</th>
          <th>सामानको नाम</th>
          <th>Name of Item</th>
          <th>परिमाण</th>
          <th>इकाई</th>
          <th class="no-print"></th>
        </tr>
        </thead>
        <tbody>
        <% @i = 1 %>
        <% @project_items47.each do |item| %>
          <tr>
            <td><%=  @i %></td>
            <td><%= item.item_register_page_no %></td>
            <td><%= item.name_of_item_ne %></td>
            <td><%= item.name_of_item_en %></td>
            <td><%= nd get_project_item_quantity(@office.id, @fiscal_year.id, item.id, 47) %></td>
            <td><%= item.unit_ne %></td>
            <td class="no-print"></td>
          </tr>
          <% @i = @i + 1 %>
        <% end %>
        </tbody>
      </table>
    </div>
  </div>
  <div id="menu2" class="container tab-pane fade"><br>
    <h3 class="float-left">माग फारामहरू</h3>
    <%= link_to new_btn.html_safe, demand_project_project_path(@project), class: "float-right" %>
    <div class="table-responsive">
      <table class="table table-sm data-table table-bordered">
        <thead>
        <tr>
          <th>क्र.स.</th>
          <th>माग संख्या</th>
          <th>मिति</th>
          <th>माग कर्ता</th>
          <th class="no-print"></th>
        </tr>
        </thead>
        <tbody>
        <% @i = 1 %>
        <% @demands.each do |item| %>
          <tr>
            <td><%=  @i %></td>
            <td><%= nd item.demand_no %></td>
            <td><%= ndate item.demand_date %></td>
            <td><%= item.demand_by %></td>
            <td class="no-print">
              <% if item.marked_as_final != true %>
                <%= link_to edit_btn.html_safe, edit_project_demand_url(item) %>
                <%= link_to destroy_btn.html_safe, project_demand_url(item), data: {method: :delete, confirm: "Are you sure to delete this release form ?"} %>
              <% end %>
              <%= link_to show_btn.html_safe, project_demand_url(item) %>
            </td>
          </tr>
          <% @i = @i + 1 %>
        <% end %>
        </tbody>
      </table>
    </div>
  </div>
  <div id="menu3" class="container tab-pane fade"><br>
    <h3 class="float-left">निकाशा फारामहरू</h3>
    <div class="table-responsive">
      <table class="table table-sm data-table table-bordered">
        <thead>
        <tr>
          <th>क्र.स.</th>
          <th>निकाशा नं</th>
          <th>निकाशा मिति</th>
          <th>सामान बुझ्ने</th>
          <th class="no-print"></th>
        </tr>
        </thead>
        <tbody>
        <% @i = 1 %>
        <% @releases.each do |item| %>
          <tr>
            <td><%=  @i %></td>
            <td><%= nd item.release_no %></td>
            <td><%= ndate item.release_date %></td>
            <td><%= item.received_by %></td>
            <td class="no-print">
              <% if item.accepted != true %>
                <%= link_to edit_btn.html_safe, edit_project_release_url(item) %>
                <%= link_to destroy_btn.html_safe, project_release_url(item), data: {method: :delete, confirm: "Are you sure to delete this release form ?"} %>
              <% end %>
              <%= link_to show_btn.html_safe, project_release_url(item) %>
            </td>
          </tr>
          <% @i = @i + 1 %>
        <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
</div>