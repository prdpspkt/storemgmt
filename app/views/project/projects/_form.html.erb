<%= form_with(model: project, local: true) do |form| %>
  <% if project.errors.any? %>
    <div id="error_explanation">
      <h2><%= pluralize(project.errors.count, "error") %> prohibited this project from being saved:</h2>

      <ul>
        <% project.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>
  <div class="row">
    <div class="col-6">
      <%= form.label :name_of_project_ne %>
      <%= form.text_field :name_of_project_ne, class: "form-control preeti", required: true %>
    </div>

    <div class="col-6">
      <%= form.label :name_of_project_en %>
      <%= form.text_field :name_of_project_en, class: "form-control", required: true %>
    </div>

    <div class="col-6">
      <%= form.label :name_of_consumer_committee %>
      <%= form.text_field :name_of_consumer_committee, class: "form-control preeti" %>
    </div>

    <div class="col-6">
      <%= form.label :address %>
      <%= form.text_field :address, class: "form-control preeti", required: true %>
    </div>

    <div class="col-4">
      <%= form.label :name_of_committee_representative %>
      <%= form.text_field :name_of_committee_representative, class: "form-control preeti" %>
    </div>

    <div class="col-4">
      <%= form.label :phone_of_committee_representative %>
      <%= form.text_field :phone_of_committee_representative, class: "form-control" %>
    </div>

    <div class="col-4">
      <%= form.label :post_of_representative %>
      <%= form.text_field :post_of_representative, class: "form-control preeti" %>
    </div>

    <div class="col-6">
      <%= form.label :contractor %>
      <%= form.text_field :contractor, class: "form-control preeti" %>
    </div>
    <div class="col-6">
      <%= form.label :name_of_contractor_representative %>
      <%= form.text_field :name_of_contractor_representative, class: "form-control preeti" %>
    </div>

    <div class="col-6">
      <%= form.label :phone_of_contractor_representative %>
      <%= form.text_field :phone_of_contractor_representative, class: "form-control" %>
    </div>

    <div class="col-6">
      <%= form.label :project_status %>
      <%= form.select(:project_status, {"सम्पन्न": 1, "निर्माणाधीन": 0}.collect { |status| [status.first, status.last] }, {include_blank: true}, {class: "form-control", required: true}) %>
    </div>
  </div>
  <div class="separator"></div>
  <div class="float-right">
    <%= form.submit :save, class: "btn btn-success" %>
  </div>
<% end %>
