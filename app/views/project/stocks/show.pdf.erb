<table class="table black-border">
  <thead>
  <tr class="text-center">
    <th rowspan="2">क्र.स.</th>
    <th rowspan="2">खाता पाना नं</th>
    <th rowspan="2">जिन्सी वर्गीकरण नं</th>
    <th rowspan="2">जिन्सी सामानको नाम</th>
    <th colspan="4">मौज्दात बाँकी</th>
    <th rowspan="2">जिन्सी सामानको भौतिक अवस्था</th>
    <th rowspan="2">कैफियत</th>
  </tr>
  <tr class="text-center">
    <th>परिमाण</th>
    <th>इकाई</th>
    <th>दर</th>
    <th>जम्मा रू</th>
  </tr>
  </thead>
  <tbody>
  <% @i = 1 %>
  <% @is_same_project = false %>
  <% @project_stock.stock_items.order("project_id ASC").each do |item| %>
    <% if item.project_id != @is_same_project %>
      <% @is_same_project = item.project_id %>
      <tr class="text-white bg-black">
        <td colspan="3">आयोजनाको नाम:</td>
        <td colspan="7"><%= item.project.name_of_project_ne %></td>
        <% @i = 1 %>
      </tr>
    <% end %>
    <tr class="text-center">
      <td><%= nd @i %></td>
      <td><%= nd item.item_register_page_no %></td>
      <td><%= nd item.item_classification_no %></td>
      <td class="text-left" style="min-width: 250px"><%= item.name_of_item_ne %></td>
      <td class="text-right"><%= nd item.quantity %></td>
      <td><%= nd item.unit_ne %></td>
      <td class="text-right"><%= nd item.rate %></td>
      <td class="text-right"><%= nd item.amount %></td>
      <td><%= item.physical_status %></td>
      <td><%= item.remarks %></td>
    </tr>
    <% @i = @i + 1 %>
  <% end %>
  </tbody>
</table>
<table class="table">
  <tr>
    <td>स्टोर प्रमुखको हस्ताक्षर</td>
    <td>शाखा प्रमुखको हस्ताक्षर</td>
    <td>कार्यालय प्रमुखको हस्ताक्षर</td>
  </tr>
  <tr>
    <td>मिति</td>
    <td>मिति</td>
    <td>मिति</td>
  </tr>
</table>