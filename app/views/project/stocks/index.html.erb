<h1>आयोजनागत वार्षिक मौज्दात</h1>
<div class="table-responsive">
  <table class="responsive nowrap table table-hover" id="dttb-office_stocks" data-sort="true" data-source="<%= url_for(format: :json) %>">
    <thead>
    <tr>
      <th data-data="fy">आर्थिक वर्ष</th>
      <th data-data="office_name">कार्यालयको नाम</th>
      <th data-data="description">विवरणको प्रकार</th>
      <th data-data="url" data-orderable="false" data-class-name="all" data-searchable="false" class="skip-export" width="100px"></th>
    </tr>
    </thead>

  </table>
</div>
<br>

<%= link_to 'वार्षिक मौज्दात तयार गर्ने', generate_project_stocks_url, class: "btn btn-primary text-white", method: :post %>