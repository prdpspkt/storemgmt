<%= form_with(model: project_demand, local: true) do |form| %>
  <% if project_demand.errors.any? %>
    <div id="error_explanation">
      <h2><%= pluralize(project_demand.errors.count, "error") %> prohibited this project_demand from being saved:</h2>

      <ul>
      <% project_demand.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
      </ul>
    </div>
  <% end %>
  <%= form.hidden_field :demand_no, class: "form-control", readonly: :readonly %>
<div class="row">
  <div class="col-4">
    <%= form.label :demand_date %>
    <%= form.text_field :demand_date, class: "form-control date-picker" %>
  </div>

  <div class="col-4">
    <%= form.label :demand_by %>
    <%= form.text_field :demand_by, class: "form-control" %>
  </div>

  <div class="col-4">
    <%= form.label :recommended_by %>
    <%= form.text_field :recommended_by, class: "form-control" %>
  </div>

  <div class="col-4">
    <%= form.label :needed_to_purchase %>
    <%= form.check_box :needed_to_purchase %>
  </div>

  <div class="col-4">
    <%= form.label :ordered_date %>
    <%= form.text_field :ordered_date, class: "form-control date-picker" %>
  </div>

  <div class="col-4">
    <%= form.label :recorded_date %>
    <%= form.text_field :recorded_date, class: "form-control date-picker" %>
  </div>

  <div class="col-4">
    <%= form.label :project_id %>
    <%= form.select(:project_id, @projects.all.collect{ |p| [p.name_of_project_ne, p.id]}, {include_blank: true}, {class: "form-control", required: :required}) %>
  </div>

</div>
  <div class="float-right">
    <%= form.submit :save, class: "btn btn-success" %>
  </div>
<% end %>
