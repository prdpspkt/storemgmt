<%= form_with(model: handover_form_item, local: true) do |form| %>
  <% if handover_form_item.errors.any? %>
    <div id="error_explanation">
      <h2><%= pluralize(handover_form_item.errors.count, "error") %> prohibited this handover_form_item from being saved:</h2>

      <ul>
        <% handover_form_item.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>
  <%= form.hidden_field :handover_form_id, value: @handover_form.id %>
  <div class="row">
    <div class="col-4">
      <%= form.label :name_of_item_ne %>
      <%= form.select(:transaction_id, @transactions.collect.map{|transaction| ["#{transaction.item.name_of_item_en} ( SKU: #{transaction.sku} MOD: #{transaction.model} IDN: #{transaction.item_identification_no})", transaction.id] },{include_blank: true}, {class: "form-control"}) %>
    </div>
    <div class="col-4">
      <%= form.label :quantity %>
      <%= form.text_field :quantity, class: "form-control" %>
    </div>

    <div class="col-4">
      <%= form.label :physical_status %>
      <%= form.text_field :physical_status, class: "form-control" %>
    </div>
  </div>
  <div class="separator"></div>
  <div class="pull-right">
    <%= form.submit "Save", class: "btn btn-success" %>
  </div>
<% end %>