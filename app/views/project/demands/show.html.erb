<h1>माग फाराम</h1>
<div class="table-responsive">
<table class="table table-bordered">
  <tr>
    <th>माग फाराम नं</th>
    <th>मिति</th>
    <th>माग गर्ने</th>
    <th>सिफारिस गर्ने</th>
    <th>आदेश दिने</th>
    <th>जिन्सिमा चढाउने</th>
  </tr>
  <tr>
    <td><%= nd @demand.demand_no %></td>
    <td><%= ndate @demand.demand_date %></td>
    <td><%= @demand.demand_by %></td>
    <td><%= @demand.recommended_by %></td>
    <td><%= @demand.ordered_by %></td>
    <td><%= @demand.recorded_by %></td>
  </tr>
</table>
</div>
<div class="text-center">
<%= link_to back_btn.html_safe, @demand.project %>
  <% if @demand.marked_as_final != true %>
  <%= link_to edit_big_btn.html_safe, edit_project_demand_path(@demand) %>
  <%= link_to final_btn.html_safe, accept_project_demand_url(@demand), method: :post, data:{confirm: "If you want to modify data you will have only 3 days."} %>
    <% end %>
  <% if @demand.entry_generated != true && @demand.marked_as_final == true %>
    <%= link_to before_final_btn.html_safe, accept_project_demand_url(@demand), id: :mark_as_not_final, method: :post %>
    <%= link_to release_generate_btn.html_safe, release_project_demand_url(@demand), method: :post %>
  <% end %>
<%= link_to print_big_btn.html_safe, print_project_demand_url(@demand, format: :pdf), target: "_blank" %>

</div>
<div class="separator"></div>
<% if @demand.marked_as_final != true %>
<h2>जिन्सी सामान थप्ने</h2>
<%= render("demand_item_form", demand_item: @demand_item) %>
<div class="separator"></div>
<% end %>
<h2>माग भैआएको जिन्सी विवरण</h2>
<div class="table-responsive">
<table class="table table-bordered">
  <tr>
    <th>सामानको विवरण </th>
    <th>स्पेसिफिकेसन</th>
    <th>परिमाण</th>
    <th>कैफियत</th>
    <th></th>
  </tr>
  <% @demand_items.each do |item| %>
  <tr id="item-<%= item.id %>">
    <td><%= item.project_item.name_of_item_ne %></td>
    <td><%= item.project_item.specification %></td>
    <td><%= item.quantity %></td>
    <td><%= item.remark %></td>
    <td>
      <% if @demand.marked_as_final != true %>
      <%= link_to(destroy_btn.html_safe, project_demand_item_path(item), method: :delete, "data-confirm": "Are you sure ?") %>
      <% end %>
    </td>
  </tr>
  <% end %>
</table>
</div>
