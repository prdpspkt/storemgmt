<div class="row">
  <div class="col-md-4">
    <h1>माग फारामहरू</h1>
  </div>
  <div class="col-md-8">
    <div class="imex float-right">
      <%= link_to new_btn.html_safe, new_project_demand_path %>
    </div>
  </div>
</div>
<div class="table-responsive">
  <table class="table data-table" id="dttb-demands" data-sort="true" data-source="<%= url_for(format: :json) %>">
    <thead>
    <tr>
      <th data-data="demand_no">माग फाराम नं</th>
      <th data-data="demand_by">माग गर्नेको विवरण</th>
      <th data-data="demand_date">मिति</th>
      <th data-data="recommended_by">सिफारिस गर्ने</th>
      <th data-data="ordered_by">स्वीकृत गर्ने</th>
      <th data-data="recorded_by">अभिलेख राख्ने</th>
      <th data-data="url" data-orderable="false" data-class-name="all" data-searchable="false" class="skip-export" width="100px"></th>
    </tr>
    </thead>

  </table>
</div>
<br>


