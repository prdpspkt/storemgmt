<div class="container">
  <div class="row text-center">
    <div class="col-12 text-right">म.ले.प.फा.नं. ५२</div>
    <div class="col-12 gov_name">प्रदेश सरकार</div>
    <div class="col-12 min_name">भौतिक पूर्वाधार विकास मन्त्रालय</div>
    <div class="col-12 off_name">खानेपानी तथा सरसफाई डिभिजन कार्यलय</div>
    <div class="col-12 min_name">गण्डकी प्रदेश, तनहुँ</div>
    <div class="col-12 form_name">जिन्सी निरीक्षण फाराम</div>
    <div class="col-12 min_name"><b>आ.व. २०७५/०७६</b></div>
  </div>
  <div class="row">
    <div class="col-12">
      <table class="table table-sm table-bordered table-black-border">
        <tr>
          <th rowspan="2">क्र.स.</th>
          <th rowspan="2">खाता पाना नं</th>
          <th rowspan="2">जिन्सी वर्गीकरण नं</th>
          <th rowspan="2" class="bibaran" width="350px">विवरण</th>
          <th colspan="4">मौज्दात बाँकी</th>
          <th colspan="2">स्पेसीफिकेसन</th>
          <th colspan="3">भौतिक परिक्षण गर्दा</th>
          <th colspan="2">चालु हालतमा</th>
          <th colspan="4">सामानको अवस्था</th>
          <th rowspan="2">कुल परिमाण</th>
          <th rowspan="2">कैफियत</th>
        </tr>
        <tr>
          <th>परिमाण</th>
          <th>इकाई</th>
          <th>दर</th>
          <th>जम्मा रू</th>
          <th>मिलान भएको संख्या</th>
          <th>मिलान नभएको संख्या</th>
          <th>घट सङ्ख्या</th>
          <th>बढ सङ्ख्या</th>
          <th>घटे/बढको सङ्ख्या</th>
          <th>प्रयोगमा रहेको</th>
          <th>प्रयोगमा नरहेको</th>
          <th>मर्मत गर्नुपर्ने</th>
          <th>लिलाम विक्री गर्नुपर्ने</th>
          <th>मिन्हा गर्नु पर्ने</th>
          <th>संरक्षण गर्नु पर्ने</th>
        </tr>
<% @c = 1 %>
<% @page = 0 %>
<% @ps.each do |p| %>
  <% if p.item_registers.blank? == false %>
    <% if @c == 30 %>
      <% @c = @c - 1 %>
      <% end %>
    <tr>
      <th colspan="3" style="font-weight: bolder!important;">आयोजनाको नाम:</th>
      <th colspan="18" style="font-weight: bolder!important;"><%= project_name_ne p.project_no %> (<%= to_nd p.project_no %>)</th>
    </tr>
    <% @c = @c + 1 %>
    <% @id = 1 %>
    <% p.items.order("name_of_item ASC").distinct.each do |i| %>
      <% @quantity = ItemRegister.where(item_id: i.id).where(project_id: p.id).where(transaction_type: 1).sum(:quantity) - ItemRegister.where(item_id: i.id).where(project_id: p.id).where.not(transaction_type: 1).sum(:quantity) %>
      <% @pwirn = ProjectItem.where(project_id: p.id).where(item_id: i.id).last.project_wise_item_register_page_no %>
      <% if @quantity > 0 %>
        <% if @c == 30 %>
          <% @c = 0 %>
          <% @page = @page + 1 %>
          </table>
          <div class="pull-right">पेज <%= to_nd @page %></div>
          <div class="pagebreak"></div>
                        <table class="table table-sm table-bordered table-black-border">                      
                            <tr>
      <th colspan="3" style="font-weight: bolder!important;">आयोजनाको नाम:</th>
      <th colspan="18" style="font-weight: bolder!important;"><%= project_name_ne p.project_no %> (<%= to_nd p.project_no %>)</th>
    </tr>
     <% @c = @c + 1 %>
        <% end %>
        <% @c = @c + 1 %>
        <tr>
          <td><%= to_nd @id %></td>
          <td><%= to_nd(i.item_no) %></td>
          <td><%= to_nd(i.item_type_no) %></td>
          <td><%= i.name_of_item %></td>
          <td><%= to_nd(@quantity) %></td>
          <td><%= i.unit %></td>
          <td style="text-align: center;"><% @iprice = ItemPrice.find_by_item_id(i.id) %>
          <% if @iprice.price.present? %>
              <% @price = @iprice.price %>
              <% else %>
            <% @price = 0 %>
              <%end %>
          <%= to_nd @price %></td>
          <td style="text-align: center;"><%= to_nd (@quantity * @price) %></td>
          <td><%= to_nd @quantity %></td>
          <td style="text-align: center;">-</td>
          <td style="text-align: center;">-</td>
          <td style="text-align: center;">-</td>
          <td style="text-align: center;">-</td>
          <td><%= to_nd @quantity %></td>
          <td style="text-align: center;">-</td>
        <td style="text-align: center;">-</td>
          <td style="text-align: center;">-</td>
          <td style="text-align: center;">-</td>
          <td style="text-align: center;">-</td>
          <td><%= to_nd @quantity %></td>
          <td></td>
        </tr>
        <% @id = @id + 1 %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
</table>
<div class="pull-right">पेज  <%= to_nd(@page + 1) %></div>
</div>
</div>
</div>
