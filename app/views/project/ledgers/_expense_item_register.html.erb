<table class="table table-sm table-borderless">
  <tbody>
  <tr>
    <td>जिन्सी सामानको नामः</td>
    <td><%= item.name_of_item_ne %></td>
    <td>&nbsp;</td>
    <td>&nbsp;</td>
    <td>आर्थिक बर्षः</td>
    <td><%= @fiscal_year.fy %></td>
  </tr>
  <tr>
    <td>एकाइ:</td>
    <td><%= item.unit_ne %></td>
    <td>&nbsp;</td>
    <td>&nbsp;</td>
    <td>जिन्सी सङ्केत नं:</td>
    <td><%= nd item.item_classification_no %></td>
  </tr>
  <tr>
    <td>स्पेसिफिकेसनः</td>
    <td><%= item.specification %></td>
    <td>&nbsp;</td>
    <td>&nbsp;</td>
    <td>जिन्सी खाता पाना.नं:</td>
    <td><%= nd item.item_register_page_no %></td>
  </tr>
  <tr>
    <td></td>
  </tr>
  </tbody>
</table>
<table class="table table-black-border table-sm">
  <thead>
  <tr class="text-center">
     <td rowspan="2">ID</td>
    <td rowspan="2">मितिः</td>
    <td rowspan="2">दाखिला / निकासा नं</td>
    <td colspan="3">स्टोर दाखिला (आम्दानी)</td>
    <td colspan="3">निकासा (खर्च)</td>
    <td colspan="3">बाँकी</td>
    <td rowspan="2" style="min-width: 200px!important;">कैफियत</td>
  </tr>
  <tr class="text-center">
    <td>परिमाण</td>
    <td>दर</td>
    <td>रकम</td>
    <td>परिमाण</td>
    <td>दर</td>
    <td>रकम</td>
    <td>परिमाण</td>
    <td>दर</td>
    <td>रकम</td>
  </tr>
  <tr>
    <td>१</td>
    <td>२</td>
    <td>३</td>
    <td>४</td>
    <td>५</td>
    <td>६</td>
    <td>७</td>
    <td>८</td>
    <td>९</td>
    <td>१०</td>
    <td>११</td>
    <td>१२</td>
  </tr>
  </thead>
  <tbody>
  <% @qty = 0 %>
  <% @amt = 0 %>
  <% @transactions = get_project_item_transactions(item, @fiscal_year) %>
  <% @transactions.each do |oeirt| %>
    <% if oeirt.transaction_type > 0 %>
      <% @qty = @qty + oeirt.quantity %>
      <% @amt = @amt + oeirt.amount %>
      <tr>
        <td><%= oeirt.id %></td>
        <td><%= ndate oeirt.transaction_date %></td>
        <td><%= nd oeirt.entry_no %></td>
        <td><%= nd oeirt.quantity %></td>
        <td><%= nd oeirt.rate %></td>
        <td><%= nd oeirt.amount %></td>
        <td>&nbsp;</td>
        <td>&nbsp;</td>
        <td>&nbsp;</td>
        <td>&nbsp;<%= nd @qty %></td>
        <td>&nbsp;</td>
        <td><%= nd @amt %></td>
        <td><%= oeirt.remarks %></td>
      </tr>
    <% end %>
    <% if oeirt.transaction_type < 0 %>
      <% @qty = @qty - oeirt.quantity %>
      <% @amt = @amt - oeirt.amount %>
      <tr>
        <td><%= ndate oeirt.transaction_date %></td>
        <td><%= nd oeirt.entry_no %></td>
        <td></td>
        <td></td>
        <td></td>
        <td><%= nd oeirt.quantity %></td>
        <td><%= nd oeirt.rate %></td>
        <td><%= nd oeirt.amount %></td>
        <td>&nbsp;<%= nd @qty %></td>
        <td>&nbsp;</td>
        <td><%= nd @amt %></td>
        <td ><%= oeirt.remarks %></td>
      </tr>
    <% end %>
  <% end %>
  </tbody>
</table>
<div class="separator"></div>