<%= form_with(model: tender_item, local: true) do |form| %>
  <% if tender_item.errors.any? %>
    <div id="error_explanation">
      <h2><%= pluralize(tender_item.errors.count, "error") %> prohibited this
        Project Tender Item from being saved:</h2>

      <ul>
        <% tender_item.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>
  <div class="row">

    <div class="col-3">
      <%= form.label :item_identification_no %>
      <%= form.text_field :item_identification_no, class: "form-control" %>
    </div>

    <div class="col-3">
      <%= form.label :model_no %>
      <%= form.text_field :model_no, class: "form-control" %>
    </div>

    <div class="col-3">
      <%= form.label :remarks %>
      <%= form.text_field :remarks, class: "form-control" %>
    </div>

    <div class="col-3">
      <%= form.label :country %>
      <%= form.text_field :country, class: "form-control" %>
    </div>

    <div class="col-3">
      <%= form.label :size %>
      <%= form.text_field :size, class: "form-control" %>
    </div>

    <div class="col-3">
      <%= form.label :approx_age %>
      <%= form.text_field :approx_age, class: "form-control" %>
    </div>

    <div class="col-3">
      <%= form.label :source %>
      <%= form.text_field :source, class: "form-control" %>
    </div>
  </div>
  <div class="separator"></div>
  <div class="float-right">
    <%= form.submit :update, class: "btn btn-success" %>
  </div>
<% end %>