<div class="row">
  <div class="col-md-6">
    <h1><%= @title %></h1>
  </div>
  <div class="col-md-6 text-right">
    <%= link_to new_btn.html_safe, new_project_item_path %>
    <%= link_to "खर्च भएर जाने जिन्सी", expense_index_project_items_url, class: "btn btn-primary" %>
    <%= link_to "खर्च भएर नजाने जिन्सी", non_expense_index_project_items_url, class: "btn btn-success" %>
    <a href="#" class="btn btn-danger" data-toggle="modal" data-target="#import_item_category">
      Import
    </a>
    <%= link_to "Export", project_items_url(format: :xlsx), class: "btn btn-primary" %>
  </div>
</div>
<div class="row">
  <div class="col-12">
    <table class="table table-sm table-bordered data-table">
      <thead>
      <tr>
        <td>क्र.स.</td>
        <td>ID</td>
        <td>जिन्सी वर्गीकरण नं</td>
        <td>सामानको नाम (नेपाली)</td>
        <td>सामानको नाम (अंग्रेजी)</td>
        <td>वर्गीकरणको नाम</td>
        <td>कैफियत</td>
      </tr>
      </thead>
      <tbody>
      <% @sn = 1 %>
      <% @items.each do |item| %>
        <tr>
          <td><%= @sn %></td>
          <td><%= nd item.id %></td>
          <td><%= item.item_classification_no %></td>
          <td><%= item.name_of_item_ne %></td>
          <td><%= item.name_of_item_en %></td>
          <td><%= item.item_category.name_ne %></td>
          <td>
            <%= link_to edit_btn.html_safe, edit_project_item_path(item) %>
            <%= link_to destroy_btn.html_safe, item, data: {method: :delete, confirm: "Are you sure ?"} %></td>
        </tr>
        <% @sn = @sn + 1 %>
      <% end %>
      </tbody>

    </table>
  </div>
</div>

<%= render 'project/items/import_form' %>