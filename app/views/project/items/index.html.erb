<h1>सामाग्रीहरू</h1>
<div class="float-right"><a href="#" class="btn btn-danger" data-toggle="modal" data-target="#import_item_category">
  Import
</a>
  <%= link_to "Export", office_items_url(format: :xlsx), class: "btn btn-success" %></div>
<table class="table data-table" id="dttb-items" data-sort="true" data-source="<%= url_for(format: :json)%>">
  <thead>
    <tr>
      <th data-data="id">ID</th>
      <th data-data="item_register_page_no">जिन्सी खाता पाना नं</th>
      <th data-data="item_classification_no">जिन्सी बर्गिकरण नं</th>
      <th data-data="name_of_item_ne">सामानको नाम(नेपाली)</th>
      <th data-data="name_of_item_en">सामानको नाम(अंग्रेजी)</th>
      <th data-data="unit_ne">इकाई</th>
      <th data-data="item_category">सामाग्रीको वर्ग</th>
      <th data-data="url" data-orderable="false" data-class-name="all" data-searchable="false" class="skip-export" width="100px"></th>
    </tr>
  </thead>

</table>

<br>

<%= link_to new_btn.html_safe, new_project_item_path %>
<%= render 'import_form' %>