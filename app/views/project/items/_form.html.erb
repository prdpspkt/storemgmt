<%= form_with(model: item, local: true) do |form| %>
  <% if item.errors.any? %>
    <div id="error_explanation">
      <h2><%= pluralize(item.errors.count, "error") %> prohibited this item from being saved:</h2>

      <ul>
      <% item.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
      </ul>
    </div>
  <% end %>
<div class="row">
  <div class="col-sm-6">
    <%= form.label :item_classification_no %>
    <%= form.select(:item_classification_no, {"खर्च भएर जाने" => 407, "खर्च भएर नजाने" => 408},{include_blank: true}, {class: "form-control", required: :required}) %>
  </div>
  <div class="col-sm-6">
    <%= form.label :name_of_item_ne %>
    <%= form.text_field :name_of_item_ne, class: "form-control preeti", required: true %>
  </div>

  <div class="col-sm-6">
    <%= form.label :name_of_item_en %>
    <%= form.text_field :name_of_item_en, class: "form-control", required: true %>
  </div>
  <div class="col-sm-6">
    <%= form.label :specification %>
    <%= form.text_field :specification, class: "form-control" %>
  </div>
  <div class="col-sm-6">
    <%= form.label :item_category_id %>
    <%= form.select(:item_category_id, @categories.collect {|p| ["#{p.name_en} (#{p.unit_en})", p.id]}, {include_blank: '-select-'}, {class: 'form-control select2', required: true}) %>
  </div>
</div>
<div class="separator"></div>
    <%= form.submit save_btn, class: "btn btn-success float-right" %>
<% end %>
