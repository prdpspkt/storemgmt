<%= form_with(model: item, local: true) do |form| %>
  <% if item.errors.any? %>
    <div id="error_explanation">
      <h2><%= pluralize(item.errors.count, "error") %> prohibited this item from being saved:</h2>

      <ul>
      <% item.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
      </ul>
    </div>
  <% end %>
<div class="row">
  <div class="col-sm-6">
    <%= form.label :item_classification_no %>
    <%= form.select(:item_classification_no, {"खर्च भएर जाने" => 52, "खर्च भएर नजाने" => 47},{include_blank: true}, {class: "form-control", required: :required}) %>
  </div>
  <div class="col-sm-6">
    <%= form.label :name_of_item_ne %>
    <%= form.text_field :name_of_item_ne, class: "form-control preeti" %>
  </div>

  <div class="col-sm-6">
    <%= form.label :name_of_item_en %>
    <%= form.text_field :name_of_item_en, class: "form-control" %>
  </div>
  <div class="col-sm-6">
    <%= form.label :specification %>
    <%= form.text_field :specification, class: "form-control" %>
  </div>
  <div class="col-sm-6">
    <%= form.label :item_category_id %>
    <%= form.select(:item_category_id, Project::ItemCategory.all.collect {|p| [p.name_en, p.id]}, {include_blank: '-select-'}, {class: 'form-control'}) %>
  </div>

  <div class="col-sm-12">
    <%= form.submit save_btn, class: "btn btn-success float-right" %>
  </div>
<% end %>
</div>