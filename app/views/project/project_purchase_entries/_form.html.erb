<%= form_with(model: project_purchase_entry, local: true) do |form| %>
  <% if project_purchase_entry.errors.any? %>
    <div id="error_explanation">
      <h2><%= pluralize(project_purchase_entry.errors.count, "error") %> prohibited this project_purchase_entry from
        being saved:</h2>

      <ul>
        <% project_purchase_entry.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>
  <div class="row">
    <div class="col-sm-6">
      <%= form.label :project_name %>
      <%= form.select(:project_id, @projects.collect { |project| [project.name_of_project_en, project.id] }, {include_blank: "select a project"}, {class: "form-control select2", required: :required}) %>
    </div>
    <div class="col-sm-6">
      <%= form.label :main_purchase_entry %>
      <%= form.select(:purchase_entry_id, @purchase_entries.collect { |entry| ["#{nd entry.entry_no}(#{ndate entry.entry_date})", entry.id] }, {}, {class: "form-control select2", required: :required}) %>
    </div>
    <div class="col-sm-6">
      <%= form.label :entry_date %>
      <%= form.text_field :entry_date, class: "form-control date-picker", required: :required, autocomplete: :off %>
    </div>

    <div class="col-sm-6">
      <%= form.label :store_keeper_signed_date %>
      <%= form.text_field :store_keeper_signed_date, class: "form-control date-picker", required: :required, autocomplete: :off %>
    </div>


    <div class="col-sm-6">
      <%= form.label :section_chief_signed_date %>
      <%= form.text_field :section_chief_signed_date, class: "form-control date-picker", required: :required, autocomplete: :off %>
    </div>


    <div class="col-sm-6">
      <%= form.label :office_chief_signed_date %>
      <%= form.text_field :office_chief_signed_date, class: "form-control date-picker", required: :required, autocomplete: :off %>
    </div>
  </div>
  <div class="separator"></div>
  <div class="pull-right">
    <%= form.submit :save, class: "btn btn-success" %>
  </div>
<% end %>
