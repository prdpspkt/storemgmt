<%= form_with(model: office_purchase_entry_item, local: true) do |form| %>
  <% if office_purchase_entry_item.errors.any? %>
    <div id="error_explanation">
      <h2><%= pluralize(office_purchase_entry_item.errors.count, "error") %> prohibited this office_purchase_entry_item
        from being saved:</h2>

      <ul>
        <% office_purchase_entry_item.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>
  <%= form.hidden_field :office_purchase_entry_id, value: @office_purchase_entry.id %>
  <div class="row">
    <div class="col-sm-4">
      <%= form.label :item_classification_no %>
      <%= form.select(:item_classification_no, {"खर्च भएर जाने" => 52, "खर्च भएर नजाने" => 47}) %>
    </div>

    <div class="col-sm-6">
      <%= form.label :name_of_item %>
      <%= form.select(:item_id, Item.all.collect { |i| [i.name_of_item_en, i.id] }, {include_blank: "select"}, {class: "form-control"}) %>
    </div>

    <div class="col-sm-2">
      <span class="badge badge-danger"> <%= form.label :is_vatable %></span>
      <%= form.check_box(:is_vatable, class: "", checked: true) %>
    </div>
  </div>
  <div id="oneirt-items">
    <div class="row">
      <div class="col-sm-2">
        <%= form.label :item_identification_no %>
        <%= form.text_field :item_identification_no, class: "form-control" %>
      </div>

      <div class="col-sm-2">
        <%= form.label :model_no %>
        <%= form.text_field :model_no, class: "form-control" %>
      </div>

      <div class="col-sm-2">
        <%= form.label :country %>
        <%= form.text_field :country, class: "form-control" %>
      </div>
      <div class="col-sm-2">
        <%= form.label :approx_age %>
        <%= form.text_field :approx_age, class: "form-control" %>
      </div>

      <div class="col-sm-2">
        <%= form.label :source %>
        <%= form.text_field :source, class: "form-control" %>
      </div>
      <div class="col-sm-2">
        <%= form.label :size %>
        <%= form.text_field :size, class: "form-control" %>
      </div>
    </div>
  </div>
  <div class="row">
    <div class="col-sm-3">
      <%= form.label :quantity %>
      <%= form.text_field :quantity, class: "form-control" %>
    </div>

    <div class="col-sm-3">
      <%= form.label :rate %>
      <%= form.text_field :rate, class: "form-control" %>
    </div>


    <div class="col-sm-4">
      <%= form.label :remarks %>
      <%= form.text_field :remarks, class: "form-control" %>
    </div>
    <div class="col-sm-2">
      <br>
      <%= form.submit :save, class: "float-right btn btn-success" %>
    </div>
  </div>
<% end %>
