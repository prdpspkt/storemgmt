<div class="row">
  <div class="col-md-4">
    <h1>आयोजनागत खरिद टेन्डरहरू</h1>
  </div>
  <div class="col-md-8">
    <div class="imex float-right">
      <%= link_to new_btn.html_safe, new_project_tender_path %>
    </div>
  </div>
</div>

<div class="table-responsive">
  <table class="responsive nowrap table table-hover" id="dttb-project_purchase_tenders" data-sort="true" data-source="<%= url_for(format: :json) %>">
    <thead>
    <tr>
      <th data-data="sn">SN</th>
      <th data-data="id">ID</th>
      <th data-data="tender_no">टेन्डर सङ्ख्या</th>
      <th data-data="tender_name">टेण्डरको नाम</th>
      <th data-data="tender_date">प्रकाशित मिति</th>
      <th data-data="url" data-orderable="false" data-class-name="all" data-searchable="false" class="skip-export" width="100px"></th>
    </tr>
    </thead>
  </table>
</div>
<br>
