<div class="row">
  <div class="col-md-4">
    <h1>जिन्सी सामाग्रीको बर्गिकरणहरु</h1>
  </div>
  <div class="col-md-8">
    <div class="imex float-right">
      <%= link_to new_btn.html_safe, new_project_item_category_path %>
      <a href="#" class="btn btn-danger" data-toggle="modal" data-target="#import_item_category">
        Import
      </a>
      <%= link_to("Export", project_item_categories_url(format: :xlsx), class: "btn btn-success") %>
      <%= link_to print_big_btn.html_safe, project_item_categories_path(format: :pdf), target: "_blank" %>
    </div>
  </div>
</div>

<!-- Button trigger modal -->
<div class="float-right">

</div>
<div class="table-responsive">
  <table class="table data-table" id="dttb-item_categories" data-sort="true" data-source="<%= url_for(format: :json) %>">
    <thead>
    <tr>
      <th data-data="id">ID</th>
      <th data-data="name_ne"><%= t("activerecord.attributes.item_category.name") %></th>
      <th data-data="name_en"></th>
      <th data-data="unit_ne"><%= t("activerecord.attributes.item_category.unit") %></th>
      <th data-data="unit_en"></th>
      <th data-data="url" data-orderable="false" data-class-name="all" data-searchable="false" class="skip-export" width="100px"></th>
    </tr>
    </thead>

  </table>
  <div class="table-responsive">
    <br>



<%= render 'project/item_categories/new_import_form' %>