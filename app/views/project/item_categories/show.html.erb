<h1> सामाग्री वर्गीकरण <small class="text-danger"><%= @item_category.name_ne %></small></h1>
<p>सामाग्रीहरुको सूची</p>
<table class="table table-sm table-striped">
  <tr>
    <th>क्र.स.</th>
    <th>सामानको नाम(नेपालि)</th>
    <th>सामानको नाम(अंग्रेजी)</th>
    <th></th>
  </tr>
  <% @i = 1 %>
  <% @items.each do |item| %>
  <tr>
    <td><%= nd @i %></td>
    <td><%= item.name_of_item_ne %></td>
    <td><%= item.name_of_item_en %></td>
    <td>
      <%= link_to destroy_btn.html_safe, project_item_path(item), method: :delete, confirm: "Are you sure ?" %>
    </td>
  </tr>
  <% end %>
</table>