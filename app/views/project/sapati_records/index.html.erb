<div class="row">
  <div class="col-md-6">
    <h1>सापटी विवरण</h1>
  </div>
  <div class="col-md-6 text-right">
<%=link_to print_big_btn.html_safe, sapati_print_project_sapati_records_path %>
  </div>
  <div class="col-12">
    <table class="table table-sm table-bordered">
      <thead>
      <tr>
        <td>क्र.स.</td>
        <td>सापटी लिएको आयोजनाको नाम</td>
        <td>सामानको नाम</td>
        <td>परिमाण</td>
        <td>सापटी दिएको आयोजनाको नाम</td>
        <td>Action</td>
      </tr>
      </thead>
      <tbody>
      <% @sn = 1 %>
      <% @sapati_records.each do |sapati| %>
        <tr>
          <td><%= nd @sn %></td>
          <td><%= Project::Project.find(sapati.to_project).name_of_project_ne %></td>
          <td><%= sapati.item.name_of_item_ne %></td>
          <td><%= sapati.quantity %></td>
          <td><%= Project::Project.find(sapati.from_project).name_of_project_ne %></td>
          <td id="sapati-<%= sapati.id %>">
            <% unless sapati.sapati_returned == true %>
              <%= link_to sapati_return_btn.html_safe, sapati_return_project_sapati_record_url(sapati), format: :js, data: {method: :post, confirm: "पहिले सापटी फिर्ता गर्न पर्याप्त मौज्दात भएको एकिन गर्नुहोस्, उपयुक्त लागेमा Ok बटन थिच्नुहोस |"} %>
            <% end %>
          </td>
        </tr>
        <% @sn = @sn + 1 %>
      <% end %>
      </tbody>
    </table>
  </div>
</div>