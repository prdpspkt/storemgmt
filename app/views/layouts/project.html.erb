<!DOCTYPE html>
<html>
<head>
  <title>सरकारी भण्डार व्यवस्थापन - <%= @title %></title>
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <meta name="viewport" content="width=device-width, user-scalable=no">

  <%= stylesheet_link_tag 'application', media: 'all', "data-turbolinks-track" => true %>
  <%= javascript_include_tag 'application', "data-turbolinks-track" => true %>
</head>

<body>
<nav class="navbar navbar-expand-lg navbar-dark bg-success">
  <div class="container">
  <a class="navbar-brand text-center" href="<%= office_dashboard_url %>">
    <%= image_tag("psims.png", height: '30') %>
  </a>
  <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarsExample09" aria-controls="navbarsExample09" aria-expanded="false" aria-label="Toggle navigation">
    <span class="navbar-toggler-icon"></span>
  </button>
  <% if user_signed_in? %>
    <div class="collapse navbar-collapse" id="navbarsExample09">
      <ul class="navbar-nav mr-auto">
        <li class="nav-item">
          <a class="nav-link" href="<%= project_dashboard_url %>">गृह पृष्ठ <i class="fa fa-home"></i></a>
        </li>
        <li class="nav-item">
          <a class="nav-link" href="<%= project_projects_path %>">आयोजनाहरू <i class="fa fa-sitemap"></i></a>
        </li>
        <li class="nav-item dropdown">
          <a class="nav-link dropdown-toggle" id="dropdown09" href="#" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">सामाग्रीहरू</a>
          <div class="dropdown-menu" aria-labelledby="dropdown09">
            <a class="dropdown-item" href="<%= project_item_categories_path %>">सामाग्रीहरुको वर्गीकरण</a>
            <a class="dropdown-item" href="<%= non_expense_index_project_items_url %>">खर्च भएर नजाने सामाग्रीहरु</a>
            <a class="dropdown-item" href="<%= expense_index_project_items_url %>">खर्च भएर जाने सामाग्रीहरु</a>

          </div>
        </li>

        <li class="nav-item dropdown">
          <a class="nav-link dropdown-toggle" id="dropdown09" href="#" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">खरिद
            <i class="fa fa-shopping-cart"></i></a>
          <div class="dropdown-menu" aria-labelledby="dropdown09">
            <a class="dropdown-item" href="<%= project_purchase_orders_path %>">खरिद आदेश</a>
            <a class="dropdown-item" href="<%= project_tenders_path %>">खरिद टेन्डरहरू</a>
            <a class="dropdown-item" href="<%= project_purchase_entries_path %>">दाखिला</a>
            <a class="dropdown-item" href="<%= project_project_purchase_entries_url %>">खरिदको आयोजनागत दाखिला</a>
          </div>
        </li>

        <li class="nav-item dropdown">
          <a class="nav-link dropdown-toggle" id="dropdown09" href="#" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">जिन्सी
            खाताहरू <i class="fa fa-list"></i></a>
          <div class="dropdown-menu" aria-labelledby="dropdown09">
            <a class="dropdown-item" href="<%= expense_item_register_project_ledgers_url %>">खर्च भएर जाने जिन्सी
              सामानको खाता</a>
            <a class="dropdown-item" href="<%= non_expense_item_register_project_ledgers_url %>">खर्च भएर नजाने जिन्सी
              सामानको खाता</a>
          </div>
        </li>
        <li class="nav-item dropdown">
          <a class="nav-link dropdown-toggle" id="dropdown09" href="#" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">बार्षिक विवरणहरू <i class="fa fa-list"></i></a>
          <div class="dropdown-menu" aria-labelledby="dropdown09">
            <a class="dropdown-item" href="<%= project_stocks_url %>">वार्षिक मौज्दात</a>
            <a class="dropdown-item" href="<%= project_item_evaluations_url %>">जिन्सी निरीक्षण प्रतिवेदन</a>
          </div>
        </li>
      </ul>
      <ul class="navbar-nav ml-auto">
        <li class="nav-item dropdown">
          <a class="nav-link dropdown-toggle" id="dropdown09" href="#" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false"><i class="fa fa-user"></i></a>
          <div class="dropdown-menu" aria-labelledby="dropdown09">
            <a class="dropdown-item" href="<%= edit_user_registration_path(current_user) %>">प्रोफाइल सम्पादन गर्ने</a>
            <a class="dropdown-item" data-method="delete" href="<%= destroy_user_session_path %>">बाहिरिने</a>
          </div>
        </li>
      </ul>
    </div>
  <% end %>
  </div>
</nav>
<div class="container" style="margin-top: 20px">
  <% if notice %>
    <div class="alert alert-info alert-dismissible fade show" role="alert">
      <strong>जानकारी</strong> <br> <%= notice %>
      <button type="button" class="close" data-dismiss="alert" aria-label="Close">
        <span aria-hidden="true">&times;</span>
      </button>
    </div>
  <% end %>
  <% flash.each do |key, value| %>
    <% if key == "error" %>
      <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <strong>त्रुटी</strong> <br> <%= value.html_safe %>
        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
          <span aria-hidden="true">&times;</span>
        </button>
      </div>
    <% end %>
  <% end %>
  <%= yield %>
</div>
<script type="text/javascript">

    $(".data-table").dataTable();
</script>

<script type="text/javascript">
    $(".date-picker").nepaliDatePicker();
    // $(".date-picker").on("click", function () {
    //     $(this).nepaliDatePicker();
    // });
    // $(".date-picker").on("focus", function () {
    //     $(this).nepaliDatePicker();
    // });
</script>
</body>
</html>
