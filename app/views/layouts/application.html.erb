<div class="container" style="margin-top: 20px">
  <% if notice %>
    <div class="alert alert-info alert-dismissible fade show" role="alert">
      <strong>जानकारी</strong> <br> <%= notice %>
      <button type="button" class="close" data-dismiss="alert" aria-label="Close">
        <span aria-hidden="true">&times;</span>
      </button>
    </div>
  <% end %>
  <% flash.each do |key, value| %>
    <% if key == "error" %>
      <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <strong>त्रुटी</strong> <br> <%= value.html_safe %>
        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
          <span aria-hidden="true">&times;</span>
        </button>
      </div>
    <% end %>
  <% end %>
  <%= yield %>
</div>
<script>
    $(document).ready( function () {
      <% unless current_user.office.blank? %>
        
        <% if current_user.office.input_system == 'preeti' %>
        $(".preeti").on("change", function () {
            var text = $(this).val();
            $(this).val(convert(text, all_rules['preeti']));
        });

        $(".preeti").on("focusout", function () {
            var text = $(this).val();
            $(this).val(convert(text, all_rules['preeti']));
        });
<% end %>
        <% end %>
    });
</script>

<div class="status_bar">
