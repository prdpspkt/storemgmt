<table class="table table-wide header-table">
  <tr>
    <td style="width: 15%">
      <%= wicked_pdf_image_tag('nepgovlogo.png', height: '50%') %>
    </td>
    <td style="width: 70%" class="text-center">
      <div class="government"><%= @office.gov %></div>
      <% if @office.ministry.present? %>
      <div class="ministry"><%= @office.ministry %></div>
        <% end %>
      <%if @office.department.present? %>
        <div class="department"><%= @office.department %></div>
      <% end %>
      <div class="office"><%= @office.office %></div>
      <div class="ministry"><%= @office.address %></div>
      <div class="office"><%= @report_name %></div>
      <div class="ministry"> आ.व. <%= @fiscal_year.fy %></div>
    </td>
    <td style="width: 15%" class="text-right form-name-text">
      <% if @form_no.nil? == false %>
      <div>म. ले. प. फा. नं. <%= nd @form_no %></div>
        <% end %>
      <% if @old_form_no.nil? == false %>
      <div>साविकको फा. नं. <%= nd @old_form_no %></div>
        <% end %>
    </td>
  </tr>
</table>