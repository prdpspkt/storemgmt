<h1>Users</h1>
<table class="table table-bordered data-table">
  <thead>
  <tr>
    <td>S.N.</td>
    <td>User ID</td>
    <td>User Name</td>
    <td>User Email</td>
    <td>Office ID</td>
    <td>Office Name</td>
    <td>Account Status</td>
    <td></td>
  </tr>
  </thead>
  <tbody>
  <% @sn = 1 %>
  <% @users.each do |user| %>
    <tr>
      <td><%= @sn %></td>
      <td><%= user.id %></td>
      <td><%= user.name %></td>
      <td><%= user.email %></td>
      <td>
        <% if !user.is_admin %>
          <%= user.office.id %>
        <% end %></td>
      <td>
        <% if !user.is_admin %>
        <%= user.office.office %>, <%= user.office.address %>
        <% end %></td>
      <td>
        <% %></td>
      <td>
        <% unless user.is_admin == true %>
        <%=link_to '<i class="fa fa-sign-in"></i>'.html_safe, admin_sign_in_as_user_url(:id => user.id),  method: :post, class: "btn btn-success" %>
        <% end %>
      </td>
    </tr>
    <% @sn = @sn + 1 %>
  <% end %>
  </tbody>
</table>