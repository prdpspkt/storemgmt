<%= form_with(model: item_assistance_register_item, local: true) do |form| %>
  <% if item_assistance_register_item.errors.any? %>
    <div id="error_explanation">
      <h2><%= pluralize(item_assistance_register_item.errors.count, "error") %> prohibited this item_assistance_register_item from being saved:</h2>

      <ul>
        <% item_assistance_register_item.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>
<%= form.hidden_field :item_assistance_register_id, value: @item_assistance_register.id %>
<div class="row">
  <div class="col-sm-3">
    <%= form.label :date %>
    <%= form.text_field :date, class: "form-control date-picker" %>
  </div>
  <div class="col-sm-3">
    <%= form.label :order_release_no %>
    <%= form.number_field :order_release_no, class: "form-control" %>
  </div>

  <div class="col-sm-3">
    <%= form.label :name_of_item %>
    <%= form.select(:office_item_id, OfficeItem.all.collect{|item| [item.name_of_item_en, item.id]}, {include_blank: "--select--"}, {class: "form-control"})%>
  </div>

  <div class="col-sm-3">
    <%= form.label :quantity %>
    <%= form.text_field :quantity, class: "form-control" %>
  </div>

  <div class="col-sm-3">
    <%= form.label :taken_date %>
    <%= form.text_field :taken_date, class: "form-control date-picker" %>
  </div>

  <div class="col-sm-3">
    <%= form.label :date_to_be_returned %>
    <%= form.text_field :date_to_be_returned, class: "form-control date-picker" %>
  </div>

  <div class="col-sm-3">
    <%= form.label :name_of_user %>
    <%= form.select(:name_of_user, Personnel.all.collect{|p| [p.name_en, p.name_ne]}, {include_blank: "--select--"}, {class: "form-control"}) %>
  </div>
</div>
  <div class="separator"></div>
  <div class="actions">
    <%= form.submit :save, class: "btn btn-success float-right" %>
  </div>
<% end %>
