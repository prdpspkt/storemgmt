<%= form_with(model: project_tender_item, local: true) do |form| %>
  <% if project_tender_item.errors.any? %>
    <div id="error_explanation">
      <h2><%= pluralize(project_tender_item.errors.count, "error") %> prohibited this project_tender_item
        from being saved:</h2>

      <ul>
        <% project_tender_item.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>
  <%= form.hidden_field :project_tender_id, value: @project_tender.id %>
  <div class="row">
    <div class="col-sm-4">
      <%= form.label :item_classification_no %>
      <%= form.select(:item_classification_no, {"खर्च भएर जाने" => 52, "खर्च भएर नजाने" => 47}, {include_blank: true}, {class: "form-control", required: :required}) %>
    </div>

    <div class="col-sm-6">
      <%= form.label :name_of_item %>
      <%= form.select(:project_item_id, ProjectItem.all.collect { |i| [i.name_of_item_en, i.id] }, {include_blank: "select"}, {class: "form-control", required: :required}) %>
    </div>

    <div class="col-sm-2">
     <span class="text-danger"><%= form.label :is_vatable %></span>
      <%= form.check_box(:is_vatable, class: "form-control", checked: true) %>
    </div>
  </div>
  <div id="oneirt-items">
    <div class="row">
      <div class="col-sm-2">
        <%= form.label :item_identification_no %>
        <%= form.text_field :item_identification_no, class: "form-control" %>
      </div>

      <div class="col-sm-2">
        <%= form.label :model_no %>
        <%= form.text_field :model_no, class: "form-control" %>
      </div>

      <div class="col-sm-2">
        <%= form.label :country %>
        <%= form.text_field :country, class: "form-control" %>
      </div>
      <div class="col-sm-2">
        <%= form.label :approx_age %>
        <%= form.text_field :approx_age, class: "form-control" %>
      </div>

      <div class="col-sm-2">
        <%= form.label :source %>
        <%= form.text_field :source, class: "form-control" %>
      </div>
      <div class="col-sm-2">
        <%= form.label :size %>
        <%= form.text_field :size, class: "form-control" %>
      </div>
    </div>
  </div>
  <div class="row">
    <div class="col-sm-3">
      <%= form.label :quantity %>
      <%= form.text_field :quantity, class: "form-control" %>
    </div>

    <div class="col-sm-3">
      <%= form.label :rate %>
      <%= form.text_field :rate, class: "form-control" %>
    </div>


    <div class="col-sm-4">
      <%= form.label :remarks %>
      <%= form.text_field :remarks, class: "form-control" %>
    </div>
    <div class="col-sm-2">
      <br>
      <%= form.submit :save, class: "btn btn-success" %>
    </div>
  </div>
<% end %>
