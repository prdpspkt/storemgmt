<%= form_with(model: project_tender_item, local: true) do |form| %>
  <% if project_tender_item.errors.any? %>
    <div id="error_explanation">
      <h2><%= pluralize(project_tender_item.errors.count, "error") %> prohibited this project_tender_item from being saved:</h2>

      <ul>
        <% project_tender_item.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form.hidden_field :project_purchase_tender_id, value: @project_purchase_tender.id %>
<div class="row">
  <div class="col-3">
    <%= form.label :name_of_item %>
    <%= form.select(:item_id, Item.all.collect{ |item| [item.name_of_item_en, item.id]}, {include_blank: true}, {required: :required, class: "form-control"}) %>
  </div>
  

  <div class="col-3">
    <%= form.label :quantity %>
    <%= form.text_field :quantity, class: "form-control", required: :required %>
  </div>

  <div class="col-3">
    <%= form.label :rate %>
    <%= form.text_field :rate, class: "form-control", required: :required %>
  </div>

  <div class="col-3">
    <%= form.label :received_date %>
    <%= form.text_field :received_date, class: "form-control date-picker", required: :required %>
  </div>
</div>
  <div class="separator"></div>

  <div class="float-right">
    <%= form.submit :add, class: "btn btn-success" %>
  </div>
<% end %>
