<%= form_with(model: office_item, local: true) do |form| %>
  <%= render 'layouts/form_errors', object: office_item %>
<div class="row">
 <div class="col-sm-6">
    <%= form.label :item_id %>
    <%= form.select(:item_id, Item.all.collect {|p| [p.name_of_item_en, p.id]}, {include_blank: '-select-'}, {class: 'form-control'}) %>
  </div>

  <div class="col-sm-6">
    <%= form.label :type %>
    <%= form.text_field :item_classification_no, class: "form-control" %>
  </div>

  <div class="col-sm-12">
    <%= form.submit :save, class: "btn btn-success float-right" %>
  </div>
</div>
<% end %>
