<h1>दाखिला प्रतिवेदन</h1>
<table class="table table-sm table-condensed table-bordered">
  <tr>
    <th>खरिद/हस्तान्तरण नं</th>
    <th>दाखिला नं</th>
    <th>दाखिला मिति</th>
    <th>दाखिला गर्ने</th>
    <th>प्रमाणित गर्ने</th>
  </tr>
  <tr>
    <td><%= nd @office_purchase_entry.purchase_handover_no %></td>
    <td><%= nd @office_purchase_entry.entry_no %></td>
    <td><%= ndate @office_purchase_entry.entry_date %></td>
    <td><%= @office_purchase_entry.store_chief_name %></td>
    <td><%= @office_purchase_entry.office_chief_name %></td>
  </tr>
</table>
<div class="separator"></div>
<div class="text-center">
  <%= link_to back_btn.html_safe, office_purchase_entries_path %>
  <%= link_to print_big_btn.html_safe, "/report/office_purchase_entry/#{@office_purchase_entry.id}" %>
  <% if @office_purchase_entry.marked_as_final != true %>
  <%= link_to edit_big_btn.html_safe, edit_office_purchase_entry_path(@office_purchase_entry) %>
  <%= link_to final_btn.html_safe, mark_ope_as_final_url(@office_purchase_entry), id: :mark_as_final, method: :post, data: "Are you sure ? You can undo this work within 3 days only." %>
  <% end %>
  <% if can_unmark(@office_purchase_entry) %>
    <%= link_to before_final_btn.html_safe, mark_ope_as_final_url(@office_purchase_entry), id: :mark_as_not_final, method: :post %>
  <% end %>
</div>
<div class="separator"></div>
<% if @office_purchase_entry.marked_as_final != true %>
<h2>सामाग्री दाखिला गर्ने</h2>
<%= render "office_purchase_entry_form", office_purchase_entry_item: @office_purchase_entry_item %>
<div class="separator"></div>
<% end %>
<h2>दाखिला भएका जिन्सि सामाग्रीहरु</h2>
<table class="table table-sm table-condensed">
  <tr>
    <th>जिन्सी वर्गीकरण नं</th>
    <th>सामानको नाम</th>
    <th>इकाई</th>
    <th>परिमाण</th>
    <th>दर</th>
    <th>जम्मा</th>
    <th>भ्याट</th>
    <th>जम्मा रकम</th>
    <th>अन्य खर्च</th>
    <th>कुल जम्मा</th>
    <th>कैफियत</th>
    <th class="no-print"></th>
  </tr>
  <% @office_purchase_entry_items.each do |item| %>
  <tr id="<%= item.id %>-opei">
    <td><%= nd item.item_classification_no %></td>
    <td><%= item.name_of_item_ne %></td>
    <td><%= item.unit_ne %></td>
    <td><%= nd item.quantity %></td>
    <td><%= nd item.rate %></td>
    <td><%= nd item.amount_without_vat %></td>
    <td><%= nd item.vat %></td>
    <td><%= nd item.amount %></td>
    <td><%= nd item.other_expense %></td>
    <td><%= nd item.total_amount %></td>
    <td><%= item.remarks %></td>
    <td><% if(@office_purchase_entry.marked_as_final != true) %> <%= link_to destroy_btn.html_safe, item, method: :delete, remote: :true, data: { confirm: "Are you sure to delete ?"} %> <% end %></td></tr>
  <% end %>
  <tr>
    <td></td>
    <td></td>
    <td></td>
    <td></td>
    <td>जम्मा</td>
    <td><%= nd @office_purchase_entry_items.sum(:amount_without_vat) %></td>
    <td><%= nd @office_purchase_entry_items.sum(:vat) %></td>
    <td><%= nd @office_purchase_entry_items.sum(:amount) %></td>
    <td><%= nd @office_purchase_entry_items.sum(:other_expense) %></td>
    <td><%= nd @office_purchase_entry_items.sum(:total_amount) %></td>
    <td></td>
  </tr>
</table>
