<h1>Project Demands</h1>

<table class="responsive nowrap table table-hover" id="dttb-project_demands" data-sort="true" data-source="<%= url_for(format: :json)%>">
  <thead>
    <tr>
      <th data-data="demand_no">Demand no</th>
      <th data-data="demand_date">Demand date</th>
      <th data-data="demand_by">Demand by</th>
      <th data-data="recommended_by">Recommended by</th>
      <th data-data="needed_to_purchase">Needed to purchase</th>
      <th data-data="ordered_by">Ordered by</th>
      <th data-data="ordered_date">Ordered date</th>
      <th data-data="recorded_by">Recorded by</th>
      <th data-data="recorded_date">Recorded date</th>
      <th data-data="user_id">User</th>
      <th data-data="fiscal_year_id">Fiscal year</th>
      <th data-data="office_id">Office</th>
      <th data-data="project_id">Project</th>
      <th data-data="item_id">Item</th>
      <th data-data="marked_as_final">Marked as final</th>
      <th data-data="url" data-orderable="false" data-class-name="all" data-searchable="false" class="skip-export" width="100px"></th>
    </tr>
  </thead>

</table>

<br>

<%= link_to 'New Project Demand', new_project_demand_path %>