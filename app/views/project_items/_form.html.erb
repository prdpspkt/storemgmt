<%= form_with(model: project_item, local: true) do |form| %>
  <% if project_item.errors.any? %>
    <div id="error_explanation">
      <h2><%= pluralize(project_item.errors.count, "error") %> prohibited this project_item from being saved:</h2>

      <ul>
      <% project_item.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
      </ul>
    </div>
  <% end %>
<div class="row">
  <div class="col-3">
    <%= form.label :item_classification_no %>
    <%= form.select(:item_classification_no, { "खर्च भएर जाने" => 52, "खर्च भएर नजाने" => 47}, {include_blank: true}, {class: "form-control", required: :required}) %>
  </div>

  <div class="col-3">
    <%= form.label :item_id %>
    <%= form.select(:item_id, Item.all.collect{ |item| [item.name_of_item_en, item.id]}, {include_blank: true}, {class: "form-control", required: :required}) %>
  </div>

  <div class="col-3">
    <%= form.label :model_no %>
    <%= form.text_field :model_no, class: "form-control" %>
  </div>

  <div class="col-3">
    <%= form.label :item_identification_no %>
    <%= form.number_field :item_identification_no, class: "form-control" %>
  </div>
</div>
  <div class="separator"></div>
  <div class="float-right">
    <%= form.submit :save, class: "btn btn-success" %>
  </div>
<% end %>
