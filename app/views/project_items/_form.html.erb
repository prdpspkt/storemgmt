<%= form_with(model: project_item, local: true) do |form| %>
  <% if project_item.errors.any? %>
    <div id="error_explanation">
      <h2><%= pluralize(project_item.errors.count, "error") %> prohibited this item from being saved:</h2>

      <ul>
      <% project_item.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
      </ul>
    </div>
  <% end %>
<div class="row">
  <div class="col-sm-6">
    <%= form.label :name_ne %>
    <%= form.text_field :name_of_item_ne, class: "form-control preeti" %>
  </div>

  <div class="col-sm-6">
    <%= form.label :name_en %>
    <%= form.text_field :name_of_item_en, class: "form-control" %>
  </div>
  <div class="col-sm-6">
    <%= form.label :specification %>
    <%= form.text_field :specification, class: "form-control" %>
  </div>

  <div class="col-sm-6">
    <%= form.label :unit %>
    <%= form.text_field :unit_ne, class: "form-control" %>
  </div>

  <div class="col-sm-6">
    <%= form.label :unit_en %>
    <%= form.text_field :unit_en, class: "form-control" %>
  </div>

  <div class="col-sm-6">
    <%= form.label :item_category_id %>
    <%= form.select(:item_category_id, ProjectItemCategory.all.collect {|p| [p.name_en, p.id]}, {include_blank: '-select-'}, {class: 'form-control'}) %>
  </div>

  <div class="col-sm-12">
    <%= form.submit save_btn, class: "btn btn-success float-right" %>
  </div>
<% end %>
</div>