<%= form_with(model: store_body, local: true) do |form| %>
  <% if store_body.errors.any? %>
    <div id="error_explanation">
      <h2><%= pluralize(store_body.errors.count, "error") %> prohibited this store_body from being saved:</h2>

      <ul>
        <% store_body.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>
  <div class="row">
    <div class="col-6">
      <%= form.label :office_chief %>
      <%= form.text_field :office_chief_name, class: "form-control" %>
    </div>

    <div class="col-6">
      <%= form.label :office_chief_degination %>
      <%= form.text_field :office_chief_degination, class: "form-control" %>
    </div>

    <div class="col-6">
      <%= form.label :section_chief %>
      <%= form.text_field :section_chief_name, class: "form-control" %>
    </div>

    <div class="col-6">
      <%= form.label :section_chief_degination %>
      <%= form.text_field :section_chief_degination, class: "form-control" %>
    </div>
    <div class="col-6">
      <%= form.label :store_keeper_name %>
      <%= form.text_field :store_keeper_name, class: "form-control" %>
    </div>
    <div class="col-6">
      <%= form.label :store_keeper_designation %>
      <%= form.text_field :store_keeper_designation, class: "form-control" %>
    </div>

  </div>
  <div class="separator"></div>
  <div class="float-right">
    <%= form.submit :save, class: "btn btn-success" %>
  </div>
<% end %>
