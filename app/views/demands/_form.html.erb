<%= form_with(model: demand, local: true) do |form| %>
  <% if demand.errors.any? %>
    <div id="error_explanation">
      <h2><%= pluralize(demand.errors.count, "error") %> prohibited this demand from being saved:</h2>

      <ul>
      <% demand.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
      </ul>
    </div>
  <% end %>

<div class="row">
  <div class="col-sm-6">
    <%= form.label :demand_date %>
    <%= form.text_field :demand_date, class: "form-control date-picker" %>
  </div>

  <div class="col-sm-6">
    <%= form.label :demand_by %>
    <%= form.text_field :demand_by, class: "form-control preeti" %>
  </div>

  <div class="col-sm-6">
    <%= form.label :recommended_by %>
    <%= form.select(:recommended_by, Personnel.all.collect {|p| [p.name_en, p.id]}, {include_blank: "छान्नुहोस्"}, {class: "form-control"}) %>
  </div>

  <div class="col-sm-6">
    <%= form.label :recommended_date %>
    <%= form.text_field :recommended_date, class: "form-control date-picker" %>
  </div>

  <div class="col-sm-6">
    <%= form.label :needed_to_purchase, "बजारबाट खरिद गर्नुपर्ने", :value => "true"  %>
    <%= form.radio_button :needed_to_purchase, true %>
    <%= form.label :needed_to_purchase, "मौज्दातबाट दिने", :value => "false" %>
    <%= form.radio_button :needed_to_purchase, false, :checked => true %>
  </div>


  <div class="col-sm-6">
    <%= form.label :ordered_date %>
    <%= form.text_field :ordered_date, class: "form-control date-picker" %>
  </div>



  <div class="col-sm-6">
    <%= form.label :recorded_date %>
    <%= form.text_field :recorded_date, class: "form-control date-picker" %>
  </div>

   <div class="col-sm-12">
    <%= form.submit save_btn.html_safe, class: "btn btn-success float-right" %>
  </div>
</div>
<% end %>
