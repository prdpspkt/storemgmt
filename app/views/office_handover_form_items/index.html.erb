<h1>Handover Form Items</h1>

<table class="responsive nowrap table table-hover" id="dttb-handover_form_items" data-sort="true" data-source="<%= url_for(format: :json)%>">
  <thead>
    <tr>
      <th data-data="item_classification_no">Item classification no</th>
      <th data-data="item_register_page_no">Item register page no</th>
      <th data-data="name_of_item">Name of item</th>
      <th data-data="specification">Specification</th>
      <th data-data="item_identification_no">Item identification no</th>
      <th data-data="model_no">Model no</th>
      <th data-data="unit">Unit</th>
      <th data-data="quantity">Quantity</th>
      <th data-data="amount">Amount</th>
      <th data-data="received_date">Received date</th>
      <th data-data="physical_status">Physical status</th>
      <th data-data="fy">Fy</th>
      <th data-data="fiscal_year_id">Fiscal year</th>
      <th data-data="user_id">User</th>
      <th data-data="office_id">Office</th>
      <th data-data="project_id">Project</th>
      <th data-data="handover_form_id">Handover form</th>
