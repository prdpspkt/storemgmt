<h1>Repair Record Registers</h1>

<table class="responsive nowrap table table-hover" id="dttb-repair_record_registers" data-sort="true" data-source="<%= url_for(format: :json)%>">
  <thead>
    <tr>
      <th data-data="name_of_item">Name of item</th>
      <th data-data="page_no">Page no</th>
