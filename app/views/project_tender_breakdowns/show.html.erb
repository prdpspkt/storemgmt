<h1>बोलपत्रको आयोजनागत विभाजन</h1>
<table class="table table-bordered">
  <tr>
    <th>टेन्डरको नाम:</th>
    <td><%= @project_tender_breakdown.project_purchase_tender.tender_name %></td>
    <th>आयोजनाको नाम: </th>
    <td><%= @project_tender_breakdown.project_name_ne %></td>
  </tr>
</table>
<div class="separator"></div>
<div class="text-center">
  <%= link_to(back_btn.html_safe, project_tender_breakdowns_path) %>
  <%= link_to(edit_big_btn.html_safe, edit_project_tender_breakdown_path(@project_tender_breakdown)) %>
  <%= link_to(before_final_btn.html_safe, project_tender_breakdowns_path) %>
  <%= link_to(final_btn.html_safe, project_tender_breakdowns_path) %>
  <%= link_to(print_big_btn.html_safe, project_tender_breakdowns_path) %>
</div>
<div class="separator"></div>
<h2>सामाग्रीहरु थप्ने</h2>
<%= render 'project_tender_breakdowns/project_tender_breakdown_item_form/', project_tender_breakdown_item: @project_tender_breakdown_item %>
<div class="separator"></div>
<table class="table table-bordered">
  <tr>
    <th>क्र.स.</th>
    <th>सामानको नाम</th>
    <th>इकाई</th>
    <th>परिमाण</th>
    <th>दर</th>
    <th>जम्मा</th>
    <th class="no-print"></th>
  </tr>
  <% @i = 1 %>
  <% @project_tender_breakdown_items.each do |item| %>
  <tr>
    <td><%=nd  @i %></td>
    <td><%= item.name_of_item_ne %></td>
    <td><%= item.unit_ne %></td>
    <td><%= nd item.quantity %></td>
    <td><%= nd item.rate %></td>
    <td><%= nd item.amount %></td>
    <td class="no-print">
      <%= link_to(destroy_btn.html_safe,project_tender_breakdown_item_path(item), data: { method: :delete, confirm: "Are you sure ?"}) %>
    </td>
  </tr>
    <% @i = @i + 1 %>
  <% end %>
  <tr>
    <td></td>
    <td></td>
    <td></td>
    <td></td>
    <td>जम्मा</td>
    <% total = @project_tender_breakdown_items.sum(:amount) %>
    <td><%= nd total %></td>
    <td></td>
  </tr>
  <tr>
    <td></td>
    <td></td>
    <td></td>
    <td></td>
    <td>भ्याट १३%</td>
    <td><%= nd (total * 0.13) %></td>
    <td></td>
  </tr>
  <tr>
    <td></td>
    <td></td>
    <td></td>
    <td></td>
    <td>कुल जम्मा</td>
    <td><%= nd (total * 0.13) + total %></td>
    <td></td>
  </tr>
</table>