<%= form_with(model: project_tender_breakdown, local: true) do |form| %>
  <% if project_tender_breakdown.errors.any? %>
    <div id="error_explanation">
      <h2><%= pluralize(project_tender_breakdown.errors.count, "error") %> prohibited this project_tender_breakdown from
        being saved:</h2>

      <ul>
        <% project_tender_breakdown.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>
  <div class="row">
    <div class="col-6">
      <%= form.label "दाखिला नं" %>
      <%= form.select(:project_purchase_entry_id, @purchase_entries.collect{|ppe| ["#{nd(ppe.entry_no)}(#{ ndate(ppe.entry_date)})", ppe.id]}, {include_blank:true}, {class: "form-control"}) %>
    </div>
    <div class="col-6">
      <%= form.label "आयोजनाको नाम" %>
      <%= form.select(:project_id, current_user.projects.collect { |project| [project.name_of_project_en, project.id] }, {include_blank: true}, {class: "form-control", required: :required}) %>
    </div>
  </div>
  <div class="separator"></div>
  <div class="float-right">
    <%= form.submit :save, class: "btn btn-success" %>
  </div>
<% end %>
