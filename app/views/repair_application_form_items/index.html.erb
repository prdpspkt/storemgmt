<h1>Repair Application Form Items</h1>

<table class="responsive nowrap table table-hover" id="dttb-repair_application_form_items" data-sort="true" data-source="<%= url_for(format: :json)%>">
  <thead>
    <tr>
      <th data-data="name_of_item">Name of item</th>
      <th data-data="item_identification_no">Item identification no</th>
      <th data-data="approx_repair_cost">Approx repair cost</th>
      <th data-data="reason_toPrepair">Reason toprepair</th>
      <th data-data="applicant_sign">Applicant sign</th>
      <th data-data="remarks">Remarks</th>
      <th data-data="user_id">User</th>
      <th data-data="office_id">Office</th>
      <th data-data="repair_application_form_id">Repair application form</th>
      <th data-data="url" data-orderable="false" data-class-name="all" data-searchable="false" class="skip-export" width="100px"></th>
    </tr>
  </thead>

</table>

<br>

<%= link_to 'New Repair Application Form Item', new_repair_application_form_item_path %>