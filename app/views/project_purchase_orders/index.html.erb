<h1>खरिद आदेश(आयोजनागत)</h1>

<table class="table table-sm" id="dttb-project_purchase_orders" data-sort="true" data-source="<%= url_for(format: :json)%>">
  <thead>
    <tr>
      <th data-data="sn">क्र.स.</th>
      <th data-data="order_no">खरिद आदेश नं</th>
      <th data-data="order_date">खरिद आदेशको मिति</th>
      <th data-data="vendor_name">आदेश पाउनेको नाम</th>
      <th data-data="vendor_phone">आदेश पाउनेको फोन</th>
      <th data-data="url" data-orderable="false" data-class-name="all" data-searchable="false" class="skip-export" width="100px"></th>
    </tr>
  </thead>

</table>

<br>

<%= link_to new_btn.html_safe, new_project_purchase_order_path %>