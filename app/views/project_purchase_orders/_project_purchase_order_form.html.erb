<%= form_with(model: project_purchase_order_item, local: true) do |form| %>
  <% if project_purchase_order_item.errors.any? %>
    <div id="error_explanation">
      <h2><%= pluralize(project_purchase_order_item.errors.count, "error") %> prohibited this project_purchase_order_item from being saved:</h2>

      <ul>
      <% project_purchase_order_item.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
      </ul>
    </div>
  <% end %>
    <%= form.hidden_field :project_purchase_order_id %>
<div class="row">
  <div class="col-2">
    <%= form.label :item_classification_no %>
    <%= form.select(:item_classification_no, {"खर्च भएर नजाने" => 47, "खर्च भएर जाने" => 52}, {include_blank: true}, {class: "form-control", required: :required}) %>
  </div>

  <div class="col-4">
    <%= form.label :name_of_item_en %>
    <%= form.select(:item_id, Item.all.collect{|item| [item.name_of_item_en, item.id]}, {include_blank: true}, {class: "form-control", required: :required}) %>
  </div>
  
  <div class="col-2">
    <%= form.label :quantity %>
    <%= form.text_field :quantity, class: "form-control" %>
  </div>

  <div class="col-2">
    <%= form.label :rate %>
    <%= form.text_field :rate, class: "form-control" %>
  </div>

  <div class="col-2">
    <%= form.label :remarks %>
    <%= form.text_field :remarks, class: "form-control" %>
  </div>
</div>
  <div class="actions">
    <%= form.submit :save, class: "btn btn-success float-right" %>
  </div>
<% end %>
