<h1>Project Demand Items</h1>

<table class="responsive nowrap table table-hover" id="dttb-project_demand_items" data-sort="true" data-source="<%= url_for(format: :json)%>">
  <thead>
    <tr>
      <th data-data="name_of_item_ne">Name of item ne</th>
      <th data-data="name_of_item_en">Name of item en</th>
