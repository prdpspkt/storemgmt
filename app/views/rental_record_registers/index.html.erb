<h1>Rental Record Registers</h1>

<table class="responsive nowrap table table-hover" id="dttb-rental_record_registers" data-sort="true" data-source="<%= url_for(format: :json)%>">
  <thead>
    <tr>
      <th data-data="name_of_item">Name of item</th>
      <th data-data="item_classification_no">Item classification no</th>
      <th data-data="is_taken_in_rent">Is taken in rent</th>
      <th data-data="is_given_in_rent">Is given in rent</th>
      <th data-data="specification">Specification</th>
