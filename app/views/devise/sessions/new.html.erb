<div class="container">
  <div class="row">
    <div class="col-md-4 offset-md-4">
<h2>Log in to continue</h2>

<%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
  
   <div class="field">
    <%= f.label "आर्थिक वर्ष" %><br />
    <%= f.select(:active_fiscal_year, FiscalYear.all.collect {|p| [p.fy, p.id]}, {include_blank: 'छान्नुहोस्'}, {class: 'form-control', required: :required}) %>
  </div>

  <div class="field">
    <%= f.label "इमेल वा युजरनेम" %><br />
    <%= f.email_field :email, autofocus: true, autocomplete: "email", class: 'form-control', required: :required %>
  </div>

  <div class="field">
    <%= f.label "पासवर्ड" %><br />
    <%= f.password_field :password, autocomplete: "current-password", class: 'form-control', required: :required %>
  </div>

  <% if devise_mapping.rememberable? %>
    <div class="field">
      <%= f.check_box :remember_me %>
      <%= f.label "सम्झिरहने" %>
    </div>
  <% end %>

  <div class="actions">
    <%= f.submit "Log in", class: "btn btn-primary float-right" %>
  </div>
<% end %>

<%= render "devise/shared/links" %>
</div>
</div>
</div>
