<%= form_with(model: office, local: true) do |form| %>
  <% if office.errors.any? %>
    <div id="error_explanation">
      <h2><%= pluralize(office.errors.count, "error") %> prohibited this office from being saved:</h2>

      <ul>
      <% office.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
      </ul>
    </div>
  <% end %>
<div class="row">
  <div class="col-sm-6">
    <%= form.label :gov %>
    <%= form.text_field :gov, class: "form-control" %>
  </div>

  <div class="col-sm-6">
    <%= form.label :ministry %>
    <%= form.text_field :ministry, class: "form-control" %>
  </div>

  <div class="col-sm-6">
    <%= form.label :department %>
    <%= form.text_field :department, class: "form-control" %>
  </div>

  <div class="col-sm-6">
    <%= form.label :office %>
    <%= form.text_field :office, class: "form-control" %>
  </div>

  <div class="col-sm-6">
    <%= form.label :address %>
    <%= form.text_field :address, class: "form-control" %>
  </div>

  <div class="col-sm-6">
    <%= form.label :phone %>
    <%= form.text_field :phone, class: "form-control" %>
  </div>

  <div class="col-sm-6">
    <%= form.label :fax %>
    <%= form.text_field :fax, class: "form-control" %>
  </div>

  <div class="col-sm-6">
    <%= form.label :email %>
    <%= form.text_field :email, class: "form-control" %>
  </div>

  <div class="col-sm-6">
    <%= form.label :office_chief %>
    <%= form.select(:office_chief, Personnel.all.collect {|p| [p.name_en, p.id]}, {include_blank: '-select-'}, {class: 'form-control'}) %>
  </div>

  <div class="col-sm-6">
    <%= form.label :section_chief %>
   <%= form.select(:section_chief, Personnel.all.collect {|p| [p.name_en, p.id]}, {include_blank: '-select-'}, {class: 'form-control'}) %>
  </div>

  <div class="col-sm-6">
    <%= form.label :store_chief %>
    <%= form.select(:store_chief, Personnel.all.collect {|p| [p.name_en, p.id]}, {include_blank: '-select-'}, {class: 'form-control'}) %>
  </div>


  <div class="col-sm-12">
    <%= form.submit "save", class: "float-right btn btn-success" %>
  </div>
</div>
<% end %>
