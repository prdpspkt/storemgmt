<h2>आयोजनाको सामाग्रीहरु </h2>
<table class="table table-sm table-bordered">
  <tr>
    <th>क्र.स.</th>
    <th>सामानको नाम</th>
    <th>Name of Item</th>
    <th>परिमाण</th>
    <th class="no-print"></th>
  </tr>
  <% @i = 1 %>
  <% @project_items.each do |item| %>
  <tr>
    <td><%= nd @i %></td>
    <td><%= item.name_of_item_ne %></td>
    <td><%= item.name_of_item_en %></td>
    <td></td>
    <td class="no-print"></td>
  </tr>
  <% @i = @i + 1 %>
  <% end %>
</table>